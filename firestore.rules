rules_version = '2';

// ===============================================================
// Assumed Data Model
// Portal do Franqueado Ubox — protótipo de regras para revisão.
// ===============================================================
//
// Collection: usuarios
// Document ID: Firebase Auth uid
// Fields:
//   - uid: string (required, immutable, == document id)
//   - email: string (required, immutable, == auth token on create)
//   - nome: string (required, 2..120)
//   - papel: "admin" | "franqueado" (required)
//   - ativo: bool (required)
//   - recusado: bool (required)
//   - unidade: string (required, 0..120)
//   - cidade: string (required, 0..120)
//   - criadoEm: timestamp (required, immutable)
//   - atualizadoEm: timestamp (required)
// PII: email. Read: owner or admin only.
// Create: self only as franqueado inactive. Self cannot change papel/ativo/recusado.
// Bootstrap: while config/adminCriado is absent, the owner may promote
// themselves to admin once (scripts/make-admin). After the lock exists, impossible.
//
// Collection: config
// Document ID: adminCriado
// Fields: uid, email, criadoEm
// Create-only by the admin who just bootstrapped. No update/delete.
//
// Collection: categorias
// Fields: nome, descricao, ordem, parentId (string|null),
//   publico, unidades, papeis, uidsExtra, uids, criadoEm, atualizadoEm
// Read: admin, or active user if publico, or active user if uid in uids.
// Write: admin only.
//
// Collection: documentos
// Fields: titulo, categoriaId, tipo, formato, status, versao, leituraObrigatoria,
//   conteudoHtml, conteudoTexto, htmlConteudo, htmlUrl, anexos,
//   publico, unidades, papeis, uidsExtra, uids,
//   criadoEm, atualizadoEm, atualizadoPor, atualizadoPorNome, publicadoEm
// Read published: admin, or active user if publico, or active user if uid in uids.
// Drafts: admin only. Write: admin only.
//
// Subcollection: documentos/{id}/versoes/{versao}
// Admin read/write. Snapshot of a published version.
//
// Collection: trilhas / quizzes
// Same audience fields plus publicado, titulo, and type-specific payload.
// Read: admin, or active user when publicado and (publico or uid in uids).
// Write: admin only.
//
// Collection: avisos
// Admin write. Active users read publico or uid in uids.
//
// Collection: leituras / aceites / tentativas / certificados / avisosLeituras
// Create-only by the owner. Readable by the owner and by admins.
// No update and no delete. Timestamps must equal request.time.
// Leitura and aceite must match the current published document version.
// Aceite text is exactly "Li e concordo" and email must match the auth token.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function userExists() {
      return signedIn() && exists(userPath());
    }

    function userData() {
      return get(userPath()).data;
    }

    function unidadePath(id) {
      return /databases/$(database)/documents/unidades/$(id);
    }

    function contaAtiva(dados) {
      return dados.ativo == true
        && dados.recusado == false
        && dados.papel in ['admin', 'franqueado', 'equipe_franqueadora', 'equipe_franqueado'];
    }

    function unidadeAtiva(dados) {
      return dados.papel == 'admin'
        || dados.papel == 'equipe_franqueadora'
        || (
          (dados.papel == 'franqueado' || dados.papel == 'equipe_franqueado')
          && 'unidadeId' in dados
          && dados.unidadeId is string
          && dados.unidadeId.size() > 0
          && exists(unidadePath(dados.unidadeId))
          && get(unidadePath(dados.unidadeId)).data.ativo == true
        );
    }

    function temLista(dados, slug) {
      return 'modulosLiberados' in dados
        && dados.modulosLiberados is list
        && slug in dados.modulosLiberados;
    }

    function isActive() {
      return signedIn() && exists(userPath()) && perfilAtivo();
    }

    function perfilAtivo() {
      let dados = userData();
      return contaAtiva(dados) && unidadeAtiva(dados);
    }

    function temModulo(slug) {
      let dados = userData();
      return temLista(dados, slug);
    }

    function podeModulo(slug) {
      return isAdmin() || temModulo(slug);
    }

    function isAdmin() {
      return signedIn() && exists(userPath()) && adminAtivo();
    }

    function adminAtivo() {
      let dados = userData();
      return dados.papel == 'admin' && dados.ativo == true && dados.recusado == false;
    }

    function emailConfere(data) {
      return !('email' in request.auth.token)
        || request.auth.token.email == null
        || data.email == request.auth.token.email;
    }

    function unidadeIdPreenchido(data) {
      return 'unidadeId' in data && data.unidadeId is string && data.unidadeId.size() > 0;
    }

    function modulosCabemNaUnidade(data) {
      return !unidadeIdPreenchido(data)
        || !('modulosLiberados' in data)
        || (
          existsAfter(unidadePath(data.unidadeId))
          && data.modulosLiberados is list
          && data.modulosLiberados.hasOnly(getAfter(unidadePath(data.unidadeId)).data.modulosLiberados)
        );
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function adminLockPath() {
      return /databases/$(database)/documents/config/adminCriado;
    }

    function validEmail(email) {
      return email is string && email.size() > 3 && email.size() < 200;
    }

    function validShort(value, maxLen) {
      return value is string && value.size() <= maxLen;
    }

    function validName(value) {
      return value is string && value.size() >= 2 && value.size() <= 120;
    }

    function audienciaValida(data) {
      return data.publico is bool
        && data.unidades is list && data.unidades.size() <= 80
        && data.papeis is list && data.papeis.size() <= 4
        && data.uidsExtra is list && data.uidsExtra.size() <= 500
        && data.uids is list && data.uids.size() <= 500;
    }

    function modulosOk(data) {
      return !('modulosLiberados' in data)
        || (data.modulosLiberados is list && data.modulosLiberados.size() <= 40);
    }

    function isValidUsuario(data, uid) {
      return data.keys().hasOnly([
          'uid', 'email', 'nome', 'papel', 'ativo', 'recusado',
          'unidade', 'cidade', 'unidadeId', 'modulosLiberados', 'criadoPor',
          'criadoEm', 'atualizadoEm'
        ])
        && data.uid == uid
        && validEmail(data.email)
        && validName(data.nome)
        && data.papel in ['admin', 'franqueado', 'equipe_franqueadora', 'equipe_franqueado']
        && data.ativo is bool
        && data.recusado is bool
        && validShort(data.unidade, 120)
        && validShort(data.cidade, 120)
        && (!('unidadeId' in data) || data.unidadeId == null || validShort(data.unidadeId, 80))
        && modulosOk(data)
        && (!('criadoPor' in data) || validShort(data.criadoPor, 128))
        && data.criadoEm is timestamp
        && data.atualizadoEm is timestamp;
    }

    function isValidUnidade(data) {
      return data.keys().hasOnly([
          'nome', 'cidade', 'responsavel', 'email', 'uid',
          'modulosLiberados', 'ativo', 'criadoEm', 'atualizadoEm', 'criadoPor'
        ])
        && validName(data.nome)
        && validShort(data.cidade, 120)
        && validName(data.responsavel)
        && validEmail(data.email)
        && (data.uid == null || (data.uid is string && data.uid.size() <= 128))
        && data.modulosLiberados is list
        && data.modulosLiberados.size() <= 40
        && data.ativo is bool
        && validShort(data.criadoPor, 128)
        && data.criadoEm is timestamp
        && data.atualizadoEm is timestamp;
    }

    function isValidCategoria(data) {
      return data.keys().hasOnly([
          'nome', 'descricao', 'ordem', 'parentId',
          'publico', 'unidades', 'papeis', 'uidsExtra', 'uids',
          'criadoEm', 'atualizadoEm'
        ])
        && validName(data.nome)
        && validShort(data.descricao, 600)
        && data.ordem is number
        && (data.parentId == null || validShort(data.parentId, 80))
        && audienciaValida(data)
        && data.criadoEm is timestamp
        && data.atualizadoEm is timestamp;
    }

    function urlOuVazio(url) {
      return url is string
        && url.size() <= 2000
        && (url.size() == 0 || url.matches('^https://.*') || url.matches('^http://.*'));
    }

    function isValidDocumento(data) {
      return data.keys().hasOnly([
          'titulo', 'categoriaId', 'tipo', 'formato', 'status', 'versao',
          'leituraObrigatoria', 'conteudoHtml', 'conteudoTexto', 'htmlConteudo',
          'htmlUrl', 'anexos', 'publico', 'unidades', 'papeis', 'uidsExtra', 'uids',
          'criadoEm', 'atualizadoEm', 'atualizadoPor', 'atualizadoPorNome', 'publicadoEm'
        ])
        && validName(data.titulo)
        && data.categoriaId is string
        && data.categoriaId.size() > 0
        && data.categoriaId.size() <= 80
        && data.tipo in ['pop', 'manual', 'processo', 'politica', 'checklist', 'html']
        && data.formato in ['richtext', 'html']
        && data.status in ['rascunho', 'publicado']
        && data.versao is int
        && data.versao >= 1
        && data.versao < 10000
        && data.leituraObrigatoria is bool
        && data.conteudoHtml is string
        && data.conteudoHtml.size() < 900000
        && data.conteudoTexto is string
        && data.conteudoTexto.size() < 900000
        && data.htmlConteudo is string
        && data.htmlConteudo.size() < 900000
        && urlOuVazio(data.htmlUrl)
        && data.anexos is list
        && data.anexos.size() <= 30
        && audienciaValida(data)
        && data.criadoEm is timestamp
        && data.atualizadoEm is timestamp
        && data.atualizadoPor == request.auth.uid
        && validShort(data.atualizadoPorNome, 120)
        && (data.publicadoEm == null || data.publicadoEm is timestamp);
    }

    function isValidVersao(data) {
      return data.keys().hasOnly([
          'versao', 'titulo', 'formato', 'conteudoHtml', 'conteudoTexto',
          'htmlConteudo', 'htmlUrl', 'criadoEm', 'autorId', 'autorNome'
        ])
        && data.versao is int
        && data.versao >= 1
        && validName(data.titulo)
        && data.formato in ['richtext', 'html']
        && data.conteudoHtml is string
        && data.conteudoHtml.size() < 900000
        && data.conteudoTexto is string
        && data.conteudoTexto.size() < 900000
        && data.htmlConteudo is string
        && data.htmlConteudo.size() < 900000
        && urlOuVazio(data.htmlUrl)
        && data.criadoEm == request.time
        && data.autorId == request.auth.uid
        && validShort(data.autorNome, 120);
    }

    function isValidTrilha(data) {
      return data.keys().hasOnly([
          'titulo', 'descricao', 'notaMinima', 'publicado', 'itens',
          'publico', 'unidades', 'papeis', 'uidsExtra', 'uids',
          'criadoEm', 'atualizadoEm'
        ])
        && validName(data.titulo)
        && validShort(data.descricao, 2000)
        && data.notaMinima is int
        && data.notaMinima >= 0
        && data.notaMinima <= 100
        && data.publicado is bool
        && data.itens is list
        && data.itens.size() <= 40
        && audienciaValida(data)
        && data.criadoEm is timestamp
        && data.atualizadoEm is timestamp;
    }

    function isValidQuiz(data) {
      return data.keys().hasOnly([
          'trilhaId', 'titulo', 'notaMinima', 'perguntas', 'publicado',
          'publico', 'unidades', 'papeis', 'uidsExtra', 'uids',
          'criadoEm', 'atualizadoEm'
        ])
        && validShort(data.trilhaId, 80)
        && validName(data.titulo)
        && data.notaMinima is int
        && data.notaMinima >= 0
        && data.notaMinima <= 100
        && data.perguntas is list
        && data.perguntas.size() <= 40
        && data.publicado is bool
        && audienciaValida(data)
        && data.criadoEm is timestamp
        && data.atualizadoEm is timestamp;
    }

    function isValidAviso(data) {
      return data.keys().hasOnly([
          'titulo', 'mensagem', 'documentoId', 'tipo',
          'publico', 'unidades', 'papeis', 'uidsExtra', 'uids', 'criadoEm'
        ])
        && validName(data.titulo)
        && validShort(data.mensagem, 600)
        && validShort(data.documentoId, 80)
        && data.tipo in ['novo', 'atualizado', 'geral']
        && audienciaValida(data)
        && data.criadoEm == request.time;
    }

    function docPath(docId) {
      return /databases/$(database)/documents/documentos/$(docId);
    }

    function docAtual(docId) {
      return get(docPath(docId)).data;
    }

    function publicadoNaVersao(docId) {
      return exists(docPath(docId))
        && docAtual(docId).status == 'publicado'
        && docAtual(docId).versao == request.resource.data.versao;
    }

    function audienciaDoDocumento(docId) {
      return docAtual(docId).publico == true
        || (docAtual(docId).uids is list && request.auth.uid in docAtual(docId).uids);
    }

    function leituraIdOk(id) {
      return id == request.auth.uid
        + '_' + request.resource.data.documentoId
        + '_v' + string(request.resource.data.versao);
    }

    function isValidLeitura(id) {
      let data = request.resource.data;
      return data.keys().hasOnly(['uid', 'documentoId', 'versao', 'lidoEm', 'titulo'])
        && data.uid == request.auth.uid
        && validShort(data.documentoId, 80)
        && data.documentoId.size() > 0
        && data.versao is int
        && data.versao >= 1
        && data.lidoEm == request.time
        && validShort(data.titulo, 180)
        && leituraIdOk(id);
    }

    function isValidAceite(id) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'uid', 'documentoId', 'versao', 'aceitoEm', 'nome', 'email', 'texto', 'titulo'
        ])
        && data.uid == request.auth.uid
        && validShort(data.documentoId, 80)
        && data.documentoId.size() > 0
        && data.versao is int
        && data.aceitoEm == request.time
        && data.nome == userData().nome
        && data.email == request.auth.token.email
        && data.texto == 'Li e concordo'
        && validShort(data.titulo, 180)
        && leituraIdOk(id)
        && exists(docPath(data.documentoId))
        && docAtual(data.documentoId).leituraObrigatoria == true;
    }

    function isValidTentativa(data) {
      return data.keys().hasOnly([
          'uid', 'quizId', 'trilhaId', 'nota', 'aprovado', 'respostas', 'respondidoEm'
        ])
        && data.uid == request.auth.uid
        && validShort(data.quizId, 80)
        && data.quizId.size() > 0
        && validShort(data.trilhaId, 80)
        && data.trilhaId.size() > 0
        && data.nota is int
        && data.nota >= 0
        && data.nota <= 100
        && data.aprovado is bool
        && data.respostas is list
        && data.respostas.size() <= 40
        && data.respondidoEm == request.time;
    }

    function tentativaPath(id) {
      return /databases/$(database)/documents/tentativas/$(id);
    }

    function trilhaPath(id) {
      return /databases/$(database)/documents/trilhas/$(id);
    }

    function temQuiz(trilha, i) {
      return trilha.itens.size() > i && trilha.itens[i].tipo == 'quiz';
    }

    function trilhaSemQuiz(trilha) {
      return trilha.itens is list
        && trilha.itens.size() <= 12
        && !temQuiz(trilha, 0) && !temQuiz(trilha, 1) && !temQuiz(trilha, 2)
        && !temQuiz(trilha, 3) && !temQuiz(trilha, 4) && !temQuiz(trilha, 5)
        && !temQuiz(trilha, 6) && !temQuiz(trilha, 7) && !temQuiz(trilha, 8)
        && !temQuiz(trilha, 9) && !temQuiz(trilha, 10) && !temQuiz(trilha, 11);
    }

    function tentativaAprovada(data) {
      return data.tentativaId is string
        && data.tentativaId.size() > 0
        && data.tentativaId != 'sem-quiz'
        && exists(tentativaPath(data.tentativaId))
        && get(tentativaPath(data.tentativaId)).data.uid == request.auth.uid
        && get(tentativaPath(data.tentativaId)).data.trilhaId == data.trilhaId
        && get(tentativaPath(data.tentativaId)).data.aprovado == true;
    }

    function certificadoLiberado(data) {
      return certificadoDeCurso(data) || certificadoLegado(data);
    }

    function certificadoDeCurso(data) {
      return data.tentativaId is string
        && data.tentativaId.size() > 0
        && data.tentativaId.size() <= 120
        && exists(cursoPath(data.trilhaId))
        && exists(tentativaProvaPath(data.tentativaId))
        && get(tentativaProvaPath(data.tentativaId)).data.uid == request.auth.uid
        && get(tentativaProvaPath(data.tentativaId)).data.cursoId == data.trilhaId
        && get(tentativaProvaPath(data.tentativaId)).data.aprovado == true;
    }

    function certificadoLegado(data) {
      return exists(trilhaPath(data.trilhaId))
        && get(trilhaPath(data.trilhaId)).data.publicado == true
        && (
          tentativaAprovada(data)
          || (
            data.tentativaId == 'sem-quiz'
            && trilhaSemQuiz(get(trilhaPath(data.trilhaId)).data)
          )
        );
    }

    function isValidCertificado(data) {
      return data.keys().hasOnly([
          'uid', 'trilhaId', 'nome', 'trilhaTitulo', 'emitidoEm', 'codigo', 'tentativaId'
        ])
        && data.uid == request.auth.uid
        && validShort(data.trilhaId, 80)
        && data.trilhaId.size() > 0
        && data.nome == userData().nome
        && validName(data.trilhaTitulo)
        && data.emitidoEm == request.time
        && data.codigo is string
        && data.codigo.size() >= 6
        && data.codigo.size() <= 40
        && validShort(data.tentativaId, 120)
        && certificadoLiberado(data);
    }

    function atualizacaoValida() {
      return request.resource.data.atualizadoEm == request.time
        && (
          (resource.data.criadoEm is timestamp && request.resource.data.criadoEm == resource.data.criadoEm)
          || (!(resource.data.criadoEm is timestamp) && request.resource.data.criadoEm == request.time)
        );
    }

    function uidsContemUsuario() {
      return resource.data.uids is list && request.auth.uid in resource.data.uids;
    }

    function isValidAvisoLeitura(data) {
      return data.keys().hasOnly(['uid', 'avisoId', 'lidaEm'])
        && data.uid == request.auth.uid
        && validShort(data.avisoId, 80)
        && data.avisoId.size() > 0
        && data.lidaEm == request.time;
    }

    function dono(data) {
      return signedIn() && data.uid == request.auth.uid;
    }

    function equipeDaMinhaUnidade() {
      let dados = userData();
      return signedIn()
        && exists(userPath())
        && contaAtiva(dados)
        && unidadeAtiva(dados)
        && dados.papel == 'franqueado'
        && unidadeIdPreenchido(dados)
        && resource.data.papel == 'equipe_franqueado'
        && unidadeIdPreenchido(resource.data)
        && resource.data.unidadeId == dados.unidadeId;
    }

    match /usuarios/{uid} {
      // Limite de 1000 expressões: com serverTimestamp o emulador avalia uma passada em que
      // request.resource ainda não existe e o && não faz curto-circuito em erro. Por isso as
      // regras caras ficam atrás de um portão barato em ternário (cond ? corpo : false).
      allow get: if isSelf(uid) || isAdmin() || equipeDaMinhaUnidade();
      allow list: if isAdmin() || equipeDaMinhaUnidade();

      allow create: if request.resource.data.papel == 'franqueado' ? (
        isSelf(uid)
          && request.resource.data.papel == 'franqueado'
          && request.resource.data.ativo == false
          && request.resource.data.modulosLiberados is list
          && request.resource.data.modulosLiberados.size() == 0
          && isValidUsuario(request.resource.data, uid)
          && emailConfere(request.resource.data)
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.recusado == false
          && (!('unidadeId' in request.resource.data) || request.resource.data.unidadeId == null || request.resource.data.unidadeId == '')
          && request.resource.data.criadoEm == request.time
          && request.resource.data.atualizadoEm == request.time
      ) : false;

      allow create: if request.resource.data.papel in ['franqueado', 'equipe_franqueadora', 'equipe_franqueado'] ? (
        isAdmin()
          && isValidUsuario(request.resource.data, uid)
          && request.resource.data.papel in ['franqueado', 'equipe_franqueadora', 'equipe_franqueado']
          && request.resource.data.recusado == false
          && request.resource.data.criadoPor == request.auth.uid
          && request.resource.data.criadoEm == request.time
          && request.resource.data.atualizadoEm == request.time
          && modulosCabemNaUnidade(request.resource.data)
      ) : false;

      allow create: if request.resource.data.papel == 'equipe_franqueado' ? (
        request.resource.data.papel == 'equipe_franqueado'
          && franqueadoCriaEquipe()
          && request.resource.data.keys().hasOnly(['uid', 'email', 'nome', 'papel', 'ativo', 'recusado', 'unidade', 'cidade', 'unidadeId', 'modulosLiberados', 'criadoPor', 'criadoEm', 'atualizadoEm'])
          && validEmail(request.resource.data.email)
          && validName(request.resource.data.nome)
          && request.resource.data.ativo == true
          && request.resource.data.recusado == false
          && request.resource.data.criadoPor == request.auth.uid
          && request.resource.data.criadoEm == request.time
          && request.resource.data.atualizadoEm == request.time
          && modulosCabemNaUnidade(request.resource.data)
      ) : false;

      allow update: if resource != null && isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'atualizadoEm'])
        && validName(request.resource.data.nome)
        && emailConfere(request.resource.data)
        && request.resource.data.atualizadoEm == request.time
        && request.resource.data.papel == resource.data.papel
        && request.resource.data.email == resource.data.email;
      allow update: if resource != null && isSelf(uid)
        && !exists(adminLockPath())
        && resource.data.papel == 'franqueado'
        && resource.data.ativo == false
        && request.resource.data.papel == 'admin'
        && request.resource.data.ativo == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['papel', 'ativo', 'atualizadoEm'])
        && request.resource.data.atualizadoEm == request.time;
      allow update: if resource != null && signedIn() && exists(userPath()) && atualizaComPerfil(uid);

      allow delete: if isAdmin();
    }

    function atualizaUsuario(uid) {
      let chaves = request.resource.data.diff(resource.data).affectedKeys();
      return (
          isSelf(uid)
          && chaves.hasOnly(['nome', 'atualizadoEm'])
          && validName(request.resource.data.nome)
          && emailConfere(request.resource.data)
          && request.resource.data.atualizadoEm == request.time
          && request.resource.data.papel == resource.data.papel
          && request.resource.data.email == resource.data.email
        )
        || (
          isSelf(uid)
          && !exists(adminLockPath())
          && resource.data.papel == 'franqueado'
          && resource.data.ativo == false
          && request.resource.data.papel == 'admin'
          && request.resource.data.ativo == true
          && chaves.hasOnly(['papel', 'ativo', 'atualizadoEm'])
          && request.resource.data.atualizadoEm == request.time
        )
        || (signedIn() && exists(userPath()) && atualizaComPerfil(uid));
    }

    function atualizaComPerfil(uid) {
      let dados = userData();
      return (
          dados.papel == 'admin'
          && dados.ativo == true
          && dados.recusado == false
          && isValidUsuario(request.resource.data, uid)
          && request.resource.data.papel == resource.data.papel
          && request.resource.data.email == resource.data.email
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.criadoEm == resource.data.criadoEm
          && request.resource.data.atualizadoEm == request.time
          && (!('criadoPor' in resource.data) || request.resource.data.criadoPor == resource.data.criadoPor)
          && modulosCabemNaUnidade(request.resource.data)
        )
        || (
          dados.papel == 'franqueado'
          && resource.data.papel == 'equipe_franqueado'
          && unidadeIdPreenchido(dados)
          && unidadeIdPreenchido(resource.data)
          && resource.data.unidadeId == dados.unidadeId
          && contaAtiva(dados)
          && unidadeAtiva(dados)
          && request.resource.data.modulosLiberados is list
          && request.resource.data.modulosLiberados.hasOnly(dados.modulosLiberados)
          && request.resource.data.papel == 'equipe_franqueado'
          && request.resource.data.atualizadoEm == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'ativo', 'modulosLiberados', 'atualizadoEm'])
          && modulosCabemNaUnidade(request.resource.data)
        );
    }

    function franqueadoCriaEquipe() {
      let dados = userData();
      return signedIn()
        && exists(userPath())
        && contaAtiva(dados)
        && unidadeAtiva(dados)
        && dados.papel == 'franqueado'
        && unidadeIdPreenchido(dados)
        && unidadeIdPreenchido(request.resource.data)
        && request.resource.data.unidadeId == dados.unidadeId
        && request.resource.data.modulosLiberados is list
        && request.resource.data.modulosLiberados.hasOnly(dados.modulosLiberados);
    }

    function franqueadoEditaEquipe() {
      let dados = userData();
      return signedIn()
        && exists(userPath())
        && contaAtiva(dados)
        && unidadeAtiva(dados)
        && dados.papel == 'franqueado'
        && unidadeIdPreenchido(dados)
        && resource.data.papel == 'equipe_franqueado'
        && unidadeIdPreenchido(resource.data)
        && resource.data.unidadeId == dados.unidadeId
        && request.resource.data.modulosLiberados is list
        && request.resource.data.modulosLiberados.hasOnly(dados.modulosLiberados);
    }

    match /unidades/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid)
        || (signedIn() && exists(userPath()) && userData().unidadeId == id);
      allow create: if isAdmin()
        && isValidUnidade(request.resource.data)
        && request.resource.data.criadoPor == request.auth.uid
        && request.resource.data.criadoEm == request.time
        && request.resource.data.atualizadoEm == request.time;
      allow update: if isAdmin()
        && isValidUnidade(request.resource.data)
        && request.resource.data.criadoPor == resource.data.criadoPor
        && request.resource.data.criadoEm == resource.data.criadoEm
        && request.resource.data.atualizadoEm == request.time;
      allow delete: if isAdmin();
    }

    match /config/{id} {
      allow read: if isAdmin();
      allow create: if id == 'adminCriado'
        && isAdmin()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'criadoEm'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.criadoEm == request.time;
      allow update, delete: if false;
    }

    match /categorias/{id} {
      allow read: if isAdmin();
      allow read: if isActive() && podeModulo('manuais') && resource.data.publico == true;
      allow read: if isActive() && podeModulo('manuais') && uidsContemUsuario();
      allow read: if isActive() && podeModulo('manuais') && !('publico' in resource.data);

      allow create: if isAdmin()
        && isValidCategoria(request.resource.data)
        && request.resource.data.criadoEm == request.time
        && request.resource.data.atualizadoEm == request.time;
      allow update: if isAdmin()
        && isValidCategoria(request.resource.data)
        && atualizacaoValida();
      allow delete: if isAdmin();
    }

    match /documentos/{id} {
      allow read: if isAdmin();
      allow read: if isActive()
        && podeModulo('manuais')
        && resource.data.status == 'publicado'
        && resource.data.publico == true;
      allow read: if isActive()
        && podeModulo('manuais')
        && resource.data.status == 'publicado'
        && uidsContemUsuario();

      allow create: if isAdmin()
        && isValidDocumento(request.resource.data)
        && request.resource.data.criadoEm == request.time
        && request.resource.data.atualizadoEm == request.time;
      allow update: if isAdmin()
        && isValidDocumento(request.resource.data)
        && atualizacaoValida();
      allow delete: if isAdmin();

      match /versoes/{versaoId} {
        allow read: if isAdmin();
        allow create: if isAdmin() && isValidVersao(request.resource.data);
        allow update, delete: if false;
      }
    }

    function legadoPublicado() {
      return resource.data.publicado == true || !('publicado' in resource.data);
    }

    function legadoPublico() {
      return resource.data.publico == true || !('publico' in resource.data);
    }

    match /trilhas/{id} {
      allow read: if isAdmin();
      allow read: if isActive() && podeModulo('universidade') && legadoPublicado() && legadoPublico();
      allow read: if isActive() && podeModulo('universidade') && legadoPublicado() && uidsContemUsuario();

      allow create: if isAdmin()
        && isValidTrilha(request.resource.data)
        && request.resource.data.criadoEm == request.time
        && request.resource.data.atualizadoEm == request.time;
      allow update: if isAdmin()
        && isValidTrilha(request.resource.data)
        && atualizacaoValida();
      allow delete: if isAdmin();
    }

    // Legado: quizzes antigos podem trazer a resposta certa junto da pergunta; só o admin lê.
    match /quizzes/{id} {
      allow read: if isAdmin();

      allow create: if isAdmin()
        && isValidQuiz(request.resource.data)
        && request.resource.data.criadoEm == request.time
        && request.resource.data.atualizadoEm == request.time;
      allow update: if isAdmin()
        && isValidQuiz(request.resource.data)
        && atualizacaoValida();
      allow delete: if isAdmin();

      // Legado: o gabarito antigo não é mais legível pelo aluno (módulo 5 usa provasGabarito).
      match /gabarito/{gabaritoId} {
        allow read: if isAdmin();
        allow write: if isAdmin();
      }
    }

    match /gabarito/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /avisos/{id} {
      allow read: if isAdmin();
      allow read: if isActive() && podeModulo('manuais') && resource.data.publico == true;
      allow read: if isActive() && podeModulo('manuais') && uidsContemUsuario();
      allow create: if isAdmin() && isValidAviso(request.resource.data);
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /leituras/{id} {
      allow read: if isAdmin() || (isActive() && dono(resource.data));
      allow create: if isValidLeitura(id)
        && isActive()
        && publicadoNaVersao(request.resource.data.documentoId)
        && (isAdmin() || audienciaDoDocumento(request.resource.data.documentoId));
      allow update, delete: if false;
    }

    match /aceites/{id} {
      allow read: if isAdmin() || (isActive() && dono(resource.data));
      allow create: if isValidAceite(id)
        && isActive()
        && publicadoNaVersao(request.resource.data.documentoId)
        && (isAdmin() || audienciaDoDocumento(request.resource.data.documentoId));
      allow update, delete: if false;
    }

    match /tentativas/{id} {
      allow read: if isAdmin() || (isActive() && temModulo('universidade') && dono(resource.data));
      // Legado: a nota vinha calculada no aparelho; novas tentativas vão para tentativasProva.
      allow create: if false;
      allow update, delete: if false;
    }

    match /certificados/{id} {
      allow read: if isAdmin() || (isActive() && temModulo('universidade') && dono(resource.data));
      allow create: if isActive()
        && temModulo('universidade')
        && isValidCertificado(request.resource.data)
        && id == request.auth.uid + '_' + request.resource.data.trilhaId;
      allow update, delete: if false;
    }

    match /avisosLeituras/{id} {
      allow read: if isAdmin() || (isActive() && dono(resource.data));
      allow create: if isActive()
        && isValidAvisoLeitura(request.resource.data)
        && id == request.auth.uid + '_' + request.resource.data.avisoId;
      allow update, delete: if false;
    }

    function perfilAcessaChamado(dados, chamado) {
      return (dados.papel == 'admin' && dados.ativo == true && dados.recusado == false)
        || (
          contaAtiva(dados)
          && unidadeAtiva(dados)
          && temLista(dados, 'chamados')
          && (
            dados.papel == 'equipe_franqueadora'
            || (
              (dados.papel == 'franqueado' || dados.papel == 'equipe_franqueado')
              && unidadeIdPreenchido(dados)
              && 'unidadeId' in chamado
              && chamado.unidadeId == dados.unidadeId
            )
          )
        );
    }

    function perfilOperaRede(dados) {
      return (dados.papel == 'admin' && dados.ativo == true && dados.recusado == false)
        || (dados.papel == 'equipe_franqueadora' && contaAtiva(dados) && unidadeAtiva(dados) && temLista(dados, 'chamados'));
    }

    function perfilPodeEncerrar(dados, chamado) {
      return contaAtiva(dados)
        && unidadeAtiva(dados)
        && temLista(dados, 'chamados')
        && (dados.papel == 'franqueado' || dados.papel == 'equipe_franqueado')
        && unidadeIdPreenchido(dados)
        && 'unidadeId' in chamado
        && chamado.unidadeId == dados.unidadeId
        && (dados.papel == 'franqueado' || request.auth.uid == chamado.abertoPor);
    }

    function acessaChamado(chamado) {
      return signedIn() && exists(userPath()) && perfilAcessaChamado(userData(), chamado);
    }

    function podeEncerrarChamado(chamado) {
      return signedIn() && exists(userPath()) && perfilPodeEncerrar(userData(), chamado);
    }

    function operaRede() {
      return signedIn() && exists(userPath()) && perfilOperaRede(userData());
    }

    function urlHttps(url) {
      return url is string && url.size() > 8 && url.size() <= 500 && url.matches('^https://.+');
    }

    function anexoChamadoOk(item) {
      return item.keys().hasOnly(['nome', 'url'])
        && item.nome is string && item.nome.size() > 0 && item.nome.size() <= 80
        && urlHttps(item.url);
    }

    function anexosChamadoOk(lista) {
      return lista is list && lista.size() <= 8
        && (lista.size() < 1 || anexoChamadoOk(lista[0]))
        && (lista.size() < 2 || anexoChamadoOk(lista[1]))
        && (lista.size() < 3 || anexoChamadoOk(lista[2]))
        && (lista.size() < 4 || anexoChamadoOk(lista[3]))
        && (lista.size() < 5 || anexoChamadoOk(lista[4]))
        && (lista.size() < 6 || anexoChamadoOk(lista[5]))
        && (lista.size() < 7 || anexoChamadoOk(lista[6]))
        && (lista.size() < 8 || anexoChamadoOk(lista[7]));
    }

    function slaChamadoCerto(data) {
      return (data.prioridade == 'urgente' && data.slaHoras == 4)
        || (data.prioridade == 'alta' && data.slaHoras == 24)
        || (data.prioridade == 'media' && data.slaHoras == 48)
        || (data.prioridade == 'baixa' && data.slaHoras == 72);
    }

    function isValidChamado(data) {
      return data.keys().hasOnly([
          'titulo', 'categoria', 'prioridade', 'descricao', 'anexos', 'status',
          'unidadeId', 'unidadeNome', 'abertoPor', 'abertoPorNome',
          'responsavelId', 'responsavelNome', 'avaliacao', 'slaHoras',
          'criadoEm', 'atualizadoEm', 'resolvidoEm', 'fechadoEm', 'reabertoEm'
        ])
        && validName(data.titulo)
        && data.categoria in ['operacao', 'marketing', 'financeiro', 'juridico', 'sistemas', 'implantacao', 'outros']
        && data.prioridade in ['baixa', 'media', 'alta', 'urgente']
        && data.descricao is string && data.descricao.size() > 0 && data.descricao.size() <= 4000
        && anexosChamadoOk(data.anexos)
        && data.status == 'aberto'
        && validShort(data.unidadeId, 80) && data.unidadeId.size() > 0
        && exists(unidadePath(data.unidadeId))
        && data.unidadeNome == get(unidadePath(data.unidadeId)).data.nome
        && data.abertoPor == request.auth.uid
        && validName(data.abertoPorNome)
        && data.responsavelId == null
        && data.responsavelNome == null
        && data.avaliacao == null
        && slaChamadoCerto(data)
        && data.criadoEm == request.time
        && data.atualizadoEm == request.time
        && data.resolvidoEm == null
        && data.fechadoEm == null
        && data.reabertoEm == null;
    }

    function nucleoChamadoIgual() {
      return request.resource.data.titulo == resource.data.titulo
        && request.resource.data.categoria == resource.data.categoria
        && request.resource.data.prioridade == resource.data.prioridade
        && request.resource.data.descricao == resource.data.descricao
        && request.resource.data.anexos == resource.data.anexos
        && request.resource.data.unidadeId == resource.data.unidadeId
        && request.resource.data.unidadeNome == resource.data.unidadeNome
        && request.resource.data.abertoPor == resource.data.abertoPor
        && request.resource.data.abertoPorNome == resource.data.abertoPorNome
        && request.resource.data.slaHoras == resource.data.slaHoras
        && request.resource.data.criadoEm == resource.data.criadoEm
        && request.resource.data.atualizadoEm == request.time;
    }

    function isValidEventoChamado(data) {
      return data.keys().hasOnly(['tipo', 'texto', 'de', 'para', 'autorId', 'autorNome', 'criadoEm'])
        && data.tipo in ['comentario', 'status', 'responsavel']
        && data.texto is string && data.texto.size() > 0 && data.texto.size() <= 2000
        && data.de is string && data.de.size() <= 120
        && data.para is string && data.para.size() <= 120
        && data.autorId == request.auth.uid
        && validName(data.autorNome)
        && data.criadoEm == request.time;
    }

    function chamadoPath(id) {
      return /databases/$(database)/documents/chamados/$(id);
    }

    function responsavelChamadoValido() {
      return (request.resource.data.responsavelId == null && request.resource.data.responsavelNome == null)
        || (
          request.resource.data.responsavelId is string
          && request.resource.data.responsavelId.size() > 0
          && request.resource.data.responsavelId.size() <= 128
          && validName(request.resource.data.responsavelNome)
        );
    }

    function reabertoPreservado() {
      return (
          !('reabertoEm' in resource.data)
          && (!('reabertoEm' in request.resource.data) || request.resource.data.reabertoEm == null)
        )
        || (
          'reabertoEm' in resource.data
          && 'reabertoEm' in request.resource.data
          && request.resource.data.reabertoEm == resource.data.reabertoEm
        );
    }

    function fechaChamado() {
      return nucleoChamadoIgual()
        && request.resource.data.status == 'fechado'
        && resource.data.status == 'resolvido'
        && request.resource.data.avaliacao is int
        && request.resource.data.avaliacao >= 1
        && request.resource.data.avaliacao <= 5
        && request.resource.data.fechadoEm == request.time
        && request.resource.data.resolvidoEm == resource.data.resolvidoEm
        && reabertoPreservado()
        && request.resource.data.responsavelId == resource.data.responsavelId
        && request.resource.data.responsavelNome == resource.data.responsavelNome
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'avaliacao', 'fechadoEm', 'atualizadoEm']);
    }

    function reabreChamado() {
      return nucleoChamadoIgual()
        && request.resource.data.status == 'aberto'
        && resource.data.status in ['fechado', 'resolvido']
        && request.resource.data.avaliacao == null
        && request.resource.data.fechadoEm == null
        && request.resource.data.resolvidoEm == null
        && request.resource.data.reabertoEm == request.time
        && request.resource.data.responsavelId == resource.data.responsavelId
        && request.resource.data.responsavelNome == resource.data.responsavelNome
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'avaliacao', 'fechadoEm', 'resolvidoEm', 'reabertoEm', 'atualizadoEm']);
    }

    function conduzChamado() {
      return nucleoChamadoIgual()
        && resource.data.status != 'fechado'
        && request.resource.data.avaliacao == resource.data.avaliacao
        && request.resource.data.fechadoEm == resource.data.fechadoEm
        && reabertoPreservado()
        && responsavelChamadoValido()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'responsavelId', 'responsavelNome', 'resolvidoEm', 'atualizadoEm'])
        && (
          request.resource.data.status == resource.data.status
          || request.resource.data.status in ['aberto', 'em_andamento', 'aguardando_franqueado', 'resolvido']
        )
        && (
          (
            request.resource.data.status == 'resolvido'
            && resource.data.status != 'resolvido'
            && request.resource.data.resolvidoEm == request.time
          )
          || request.resource.data.resolvidoEm == resource.data.resolvidoEm
        );
    }

    function tiraDeFechado() {
      return nucleoChamadoIgual()
        && resource.data.status == 'fechado'
        && request.resource.data.status in ['aberto', 'em_andamento', 'aguardando_franqueado', 'resolvido']
        && request.resource.data.avaliacao == null
        && request.resource.data.fechadoEm == null
        && request.resource.data.resolvidoEm == null
        && request.resource.data.reabertoEm == request.time
        && responsavelChamadoValido()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'responsavelId', 'responsavelNome', 'avaliacao', 'fechadoEm', 'resolvidoEm', 'reabertoEm', 'atualizadoEm']);
    }

    function comentarioConfere(id) {
      let dados = userData();
      let chamado = get(chamadoPath(id)).data;
      return isValidEventoChamado(request.resource.data)
        && request.resource.data.autorNome == dados.nome
        && perfilAcessaChamado(dados, chamado);
    }

    function statusConfere(id) {
      let dados = userData();
      let antes = get(chamadoPath(id)).data;
      let depois = getAfter(chamadoPath(id)).data;
      return isValidEventoChamado(request.resource.data)
        && request.resource.data.autorNome == dados.nome
        && request.resource.data.para == depois.status
        && antes.status != depois.status
        && (perfilOperaRede(dados) || perfilPodeEncerrar(dados, antes));
    }

    function responsavelConfere(id) {
      let dados = userData();
      let antes = get(chamadoPath(id)).data;
      let depois = getAfter(chamadoPath(id)).data;
      return isValidEventoChamado(request.resource.data)
        && request.resource.data.autorNome == dados.nome
        && request.resource.data.para == depois.responsavelNome
        && antes.responsavelId != depois.responsavelId
        && perfilOperaRede(dados);
    }

    match /chamados/{chamadoId} {
      allow read: if acessaChamado(resource.data);
      allow create: if request.resource.data.status == 'aberto' ? (
        request.resource.data.status == 'aberto'
          && request.resource.data.abertoPor == request.auth.uid
          && slaChamadoCerto(request.resource.data)
          && isValidChamado(request.resource.data)
          && podeEncerrarChamado(request.resource.data)
      ) : false;
      allow update: if request.resource.data.status == 'fechado' && resource.data.status == 'resolvido' ? (
        resource != null && request.resource.data.status == 'fechado' && resource.data.abertoPor == request.auth.uid && fechaChamado()
      ) : false;
      allow update: if request.resource.data.status == 'aberto' && resource.data.status in ['fechado', 'resolvido'] ? (
        resource != null && request.resource.data.status == 'aberto' && resource.data.abertoPor == request.auth.uid && reabreChamado()
      ) : false;
      allow update: if request.resource.data.status == 'fechado' && resource.data.status == 'resolvido' ? (
        resource != null && request.resource.data.status == 'fechado' && request.auth.uid != resource.data.abertoPor && podeEncerrarChamado(resource.data) && fechaChamado()
      ) : false;
      allow update: if request.resource.data.status == 'aberto' && resource.data.status in ['fechado', 'resolvido'] ? (
        resource != null && request.resource.data.status == 'aberto' && request.auth.uid != resource.data.abertoPor && podeEncerrarChamado(resource.data) && reabreChamado()
      ) : false;
      allow update: if resource.data.status != 'fechado' && request.resource.data.atualizadoEm == request.time ? (
        resource != null && resource.data.status != 'fechado' && (isAdmin() || operaRede()) && conduzChamado()
      ) : false;
      allow update: if resource.data.status == 'fechado' && request.resource.data.atualizadoEm == request.time ? (
        resource != null && resource.data.status == 'fechado' && (isAdmin() || operaRede()) && tiraDeFechado()
      ) : false;
      allow delete: if false;

      match /eventos/{eventoId} {
        allow read: if acessaChamado(get(chamadoPath(chamadoId)).data);
        allow create: if request.resource.data.tipo == 'comentario' && request.resource.data.autorId == request.auth.uid ? (
          request.resource.data.tipo == 'comentario' && comentarioConfere(chamadoId)
        ) : false;
        allow create: if request.resource.data.tipo == 'status' && request.resource.data.autorId == request.auth.uid ? (
          request.resource.data.tipo == 'status' && statusConfere(chamadoId)
        ) : false;
        allow create: if request.resource.data.tipo == 'responsavel' && request.resource.data.autorId == request.auth.uid ? (
          request.resource.data.tipo == 'responsavel' && responsavelConfere(chamadoId)
        ) : false;
        allow update, delete: if false;
      }
    }

    // ===============================================================
    // Central de Acessos e Senhas (Módulo 3)
    // ===============================================================

    function urlOpcionalHttps(url) {
      return url is string && (url == '' || (url.size() >= 8 && url.size() <= 500 && url.matches('^https://.+')));
    }

    function acessoPath(id) {
      return /databases/$(database)/documents/acessos/$(id);
    }

    function acessoDoc(id) {
      return exists(acessoPath(id)) ? get(acessoPath(id)).data : getAfter(acessoPath(id)).data;
    }

    function visivelParaItemOk(item) {
      return item is string && item.size() > 0 && item.size() <= 128;
    }

    function visivelParaOk(lista) {
      return lista is list && lista.size() <= 20
        && (lista.size() < 1 || visivelParaItemOk(lista[0]))
        && (lista.size() < 2 || visivelParaItemOk(lista[1]))
        && (lista.size() < 3 || visivelParaItemOk(lista[2]))
        && (lista.size() < 4 || visivelParaItemOk(lista[3]))
        && (lista.size() < 5 || visivelParaItemOk(lista[4]))
        && (lista.size() < 6 || visivelParaItemOk(lista[5]))
        && (lista.size() < 7 || visivelParaItemOk(lista[6]))
        && (lista.size() < 8 || visivelParaItemOk(lista[7]))
        && (lista.size() < 9 || visivelParaItemOk(lista[8]))
        && (lista.size() < 10 || visivelParaItemOk(lista[9]))
        && (lista.size() < 11 || visivelParaItemOk(lista[10]))
        && (lista.size() < 12 || visivelParaItemOk(lista[11]))
        && (lista.size() < 13 || visivelParaItemOk(lista[12]))
        && (lista.size() < 14 || visivelParaItemOk(lista[13]))
        && (lista.size() < 15 || visivelParaItemOk(lista[14]))
        && (lista.size() < 16 || visivelParaItemOk(lista[15]))
        && (lista.size() < 17 || visivelParaItemOk(lista[16]))
        && (lista.size() < 18 || visivelParaItemOk(lista[17]))
        && (lista.size() < 19 || visivelParaItemOk(lista[18]))
        && (lista.size() < 20 || visivelParaItemOk(lista[19]));
    }

    function isValidAcesso(data) {
      return data.keys().hasOnly([
          'nome', 'categoria', 'url', 'escopo', 'unidadeId', 'unidadeNome',
          'responsavelId', 'responsavelNome', 'visivelPara', 'visivelParaEquipe',
          'ultimaTrocaEm', 'pendenteTroca', 'criadoPor', 'criadoPorNome',
          'criadoEm', 'atualizadoEm'
        ])
        && validName(data.nome)
        && data.categoria in ['gestao', 'email', 'redes_sociais', 'portaria', 'cameras', 'outros']
        && urlOpcionalHttps(data.url)
        && data.escopo in ['unidade', 'rede']
        && data.unidadeId is string && data.unidadeId.size() <= 80
        && data.unidadeNome is string && data.unidadeNome.size() <= 120
        && (data.responsavelId == null || (data.responsavelId is string && data.responsavelId.size() <= 128))
        && data.responsavelNome is string && data.responsavelNome.size() > 0 && data.responsavelNome.size() <= 120
        && visivelParaOk(data.visivelPara)
        && data.visivelParaEquipe is bool
        && data.pendenteTroca is bool
        && data.criadoPor is string && data.criadoPor.size() <= 128
        && validName(data.criadoPorNome)
        && data.ultimaTrocaEm is timestamp
        && data.criadoEm is timestamp
        && data.atualizadoEm is timestamp;
    }

    function perfilAcessaMetadadosAcesso(dados, acesso) {
      return contaAtiva(dados) && (
        isAdmin()
        || (
          temLista(dados, 'senhas') && (
            acesso.escopo == 'rede'
            || (dados.papel == 'equipe_franqueadora' && unidadeAtiva(dados))
            || (
              unidadeAtiva(dados)
              && unidadeIdPreenchido(dados)
              && dados.unidadeId == acesso.unidadeId
            )
          )
        )
      );
    }

    function acessaMetadadosAcesso(acesso) {
      return signedIn() && exists(userPath()) && perfilAcessaMetadadosAcesso(userData(), acesso);
    }

    function podeCriarAcesso(data) {
      let dados = userData();
      return contaAtiva(dados) && (
        (
          data.escopo == 'unidade'
          && dados.papel == 'franqueado'
          && unidadeAtiva(dados)
          && unidadeIdPreenchido(dados)
          && dados.unidadeId == data.unidadeId
          && temLista(dados, 'senhas')
          && exists(unidadePath(data.unidadeId))
          && data.unidadeNome == get(unidadePath(data.unidadeId)).data.nome
          && data.criadoPor == request.auth.uid
          && data.criadoPorNome == dados.nome
          && data.criadoEm == request.time
          && data.atualizadoEm == request.time
          && data.ultimaTrocaEm == request.time
        )
        || (
          data.escopo == 'rede'
          && (isAdmin() || (dados.papel == 'equipe_franqueadora' && contaAtiva(dados) && temLista(dados, 'senhas')))
          && data.unidadeId == ''
          && data.unidadeNome == ''
          && data.visivelPara.size() == 0
          && data.visivelParaEquipe == false
          && data.criadoPor == request.auth.uid
          && data.criadoPorNome == dados.nome
          && data.criadoEm == request.time
          && data.atualizadoEm == request.time
          && data.ultimaTrocaEm == request.time
        )
      );
    }

    function rotacionouSegredo(acessoId) {
      let segredoRef = /databases/$(database)/documents/acessos/$(acessoId)/segredo/atual;
      return existsAfter(segredoRef) && getAfter(segredoRef).data.atualizadoEm == request.time;
    }

    function trocaOuPreserva(acessoId, antes, depois) {
      let trocou = rotacionouSegredo(acessoId);
      return (
        depois.ultimaTrocaEm == antes.ultimaTrocaEm
        || (depois.ultimaTrocaEm == request.time && trocou)
      ) && (
        !(antes.pendenteTroca == true && depois.pendenteTroca == false)
        || trocou
      );
    }

    function podeAtualizarAcesso(acessoId, antes, depois) {
      let dados = userData();
      return contaAtiva(dados)
        && depois.escopo == antes.escopo
        && depois.unidadeId == antes.unidadeId
        && depois.unidadeNome == antes.unidadeNome
        && depois.criadoPor == antes.criadoPor
        && depois.criadoPorNome == antes.criadoPorNome
        && depois.criadoEm == antes.criadoEm
        && depois.atualizadoEm == request.time
        && trocaOuPreserva(acessoId, antes, depois)
        && (
          (
            antes.escopo == 'unidade'
            && unidadeAtiva(dados)
            && unidadeIdPreenchido(dados)
            && dados.unidadeId == antes.unidadeId
            && temLista(dados, 'senhas')
            && dados.papel == 'franqueado'
          )
          || (
            antes.escopo == 'rede'
            && depois.visivelPara.size() == 0
            && depois.visivelParaEquipe == false
            && (isAdmin() || (dados.papel == 'equipe_franqueadora' && contaAtiva(dados) && temLista(dados, 'senhas')))
          )
        );
    }

    function perfilPodeLerSegredo(dados, acesso) {
      return contaAtiva(dados) && (
        (
          acesso.escopo == 'rede' && (
            isAdmin()
            || (temLista(dados, 'senhas') && (dados.papel == 'equipe_franqueadora' || (unidadeAtiva(dados) && unidadeIdPreenchido(dados))))
          )
        )
        || (
          acesso.escopo == 'unidade'
          && temLista(dados, 'senhas')
          && unidadeAtiva(dados)
          && unidadeIdPreenchido(dados)
          && dados.unidadeId == acesso.unidadeId
          && (
            dados.papel == 'franqueado'
            || (dados.papel == 'equipe_franqueado' && (acesso.visivelParaEquipe == true || request.auth.uid in acesso.visivelPara))
          )
        )
      );
    }

    function perfilPodeEscreverSegredo(dados, acesso) {
      return contaAtiva(dados) && (
        (
          acesso.escopo == 'rede' && (
            isAdmin()
            || (dados.papel == 'equipe_franqueadora' && temLista(dados, 'senhas'))
          )
        )
        || (
          acesso.escopo == 'unidade'
          && dados.papel == 'franqueado'
          && temLista(dados, 'senhas')
          && unidadeAtiva(dados)
          && unidadeIdPreenchido(dados)
          && dados.unidadeId == acesso.unidadeId
        )
      );
    }

    function isValidSegredo(data) {
      return data.keys().hasOnly(['login', 'senha', 'notas', 'atualizadoEm', 'atualizadoPor'])
        && data.login is string && data.login.size() <= 200
        && data.senha is string && data.senha.size() > 0 && data.senha.size() <= 500
        && data.notas is string && data.notas.size() <= 2000
        && data.atualizadoPor == request.auth.uid
        && data.atualizadoEm == request.time;
    }

    function isValidEventoAcesso(data) {
      return data.keys().hasOnly(['tipo', 'texto', 'autorId', 'autorNome', 'criadoEm'])
        && data.tipo in ['criacao', 'atualizacao', 'revelou', 'copiou', 'permissao', 'troca_senha']
        && (
          (data.tipo == 'criacao' && data.texto == 'Acesso criado.')
          || (data.tipo == 'atualizacao' && data.texto == 'Acesso atualizado.')
          || (data.tipo == 'permissao' && data.texto == 'Permissão alterada.')
          || (data.tipo == 'troca_senha' && data.texto == 'Senha trocada.')
          || (data.tipo == 'revelou' && data.texto == 'Visualizou a senha.')
          || (data.tipo == 'copiou' && data.texto == 'Copiou a senha.')
        )
        && data.autorId == request.auth.uid
        && validName(data.autorNome)
        && data.criadoEm == request.time;
    }

    function isValidSolicitacaoAcesso(data) {
      return data.keys().hasOnly([
          'tipo', 'status', 'acessoId', 'acessoNome', 'unidadeId', 'unidadeNome',
          'solicitadoPor', 'solicitadoPorNome', 'motivo', 'alvoUid', 'alvoNome',
          'decididoPor', 'decididoPorNome', 'criadoEm', 'atualizadoEm'
        ])
        && data.tipo in ['pedir_acesso', 'novo_sistema', 'revogar', 'trocar_senha']
        && data.status in ['aberta', 'aprovada', 'recusada', 'concluida']
        && data.acessoId is string && data.acessoId.size() <= 80
        && data.acessoNome is string && data.acessoNome.size() <= 120
        && data.unidadeId is string && data.unidadeId.size() > 0 && data.unidadeId.size() <= 80
        && data.unidadeNome is string && data.unidadeNome.size() <= 120
        && data.solicitadoPor is string && data.solicitadoPor.size() > 0 && data.solicitadoPor.size() <= 128
        && validName(data.solicitadoPorNome)
        && data.motivo is string && data.motivo.size() <= 2000
        && data.alvoUid is string && data.alvoUid.size() <= 128
        && data.alvoNome is string && data.alvoNome.size() <= 120
        && (data.decididoPor == null || (data.decididoPor is string && data.decididoPor.size() <= 128))
        && (data.decididoPorNome == null || validName(data.decididoPorNome))
        && data.criadoEm is timestamp
        && data.atualizadoEm is timestamp;
    }

    function podeLerSolicitacao(data) {
      let dados = userData();
      return contaAtiva(dados) && (
        isAdmin()
        || (dados.papel == 'equipe_franqueadora' && temLista(dados, 'senhas'))
        || (
          temLista(dados, 'senhas')
          && unidadeAtiva(dados)
          && unidadeIdPreenchido(dados)
          && dados.unidadeId == data.unidadeId
        )
      );
    }

    function podeCriarSolicitacao(data) {
      let dados = userData();
      return contaAtiva(dados)
        && unidadeAtiva(dados)
        && unidadeIdPreenchido(dados)
        && temLista(dados, 'senhas')
        && dados.papel in ['franqueado', 'equipe_franqueado']
        && dados.unidadeId == data.unidadeId
        && exists(unidadePath(data.unidadeId))
        && data.unidadeNome == get(unidadePath(data.unidadeId)).data.nome
        && (
          data.acessoId == ''
          || (
            exists(acessoPath(data.acessoId))
            && get(acessoPath(data.acessoId)).data.unidadeId == data.unidadeId
            && get(acessoPath(data.acessoId)).data.escopo == 'unidade'
          )
        )
        && data.solicitadoPor == request.auth.uid
        && data.solicitadoPorNome == dados.nome
        && data.status == 'aberta'
        && data.decididoPor == null
        && data.decididoPorNome == null
        && data.criadoEm == request.time
        && data.atualizadoEm == request.time;
    }

    function podeDecidirSolicitacao() {
      let dados = userData();
      return contaAtiva(dados)
        && (
          (
            dados.papel == 'franqueado'
            && unidadeAtiva(dados)
            && unidadeIdPreenchido(dados)
            && dados.unidadeId == resource.data.unidadeId
            && temLista(dados, 'senhas')
          )
          || (
            resource.data.unidadeId == ''
            && (isAdmin() || (dados.papel == 'equipe_franqueadora' && temLista(dados, 'senhas')))
          )
        )
        && resource.data.status == 'aberta'
        && request.resource.data.status in ['aprovada', 'recusada', 'concluida']
        && request.resource.data.decididoPor == request.auth.uid
        && request.resource.data.decididoPorNome == dados.nome
        && request.resource.data.atualizadoEm == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decididoPor', 'decididoPorNome', 'atualizadoEm']);
    }

    match /acessos/{acessoId} {
      allow read: if acessaMetadadosAcesso(resource.data);
      allow create: if request.resource.data.escopo in ['unidade', 'rede'] && request.resource.data.criadoPor == request.auth.uid ? (
        signedIn() && exists(userPath()) && isValidAcesso(request.resource.data) && podeCriarAcesso(request.resource.data)
      ) : false;
      allow update: if request.resource.data.escopo == resource.data.escopo && request.resource.data.atualizadoEm == request.time ? (
        signedIn() && exists(userPath()) && resource != null && isValidAcesso(request.resource.data) && podeAtualizarAcesso(acessoId, resource.data, request.resource.data)
      ) : false;
      allow delete: if false;

      match /segredo/{segredoId} {
        allow read: if segredoId == 'atual' && signedIn() && exists(userPath()) && perfilPodeLerSegredo(userData(), acessoDoc(acessoId));
        allow create, update: if segredoId == 'atual'
          && signedIn() && exists(userPath())
          && isValidSegredo(request.resource.data)
          && perfilPodeEscreverSegredo(userData(), acessoDoc(acessoId))
          // a troca direta do segredo exige registrar a troca no acesso no mesmo lote
          && existsAfter(acessoPath(acessoId))
          && getAfter(acessoPath(acessoId)).data.ultimaTrocaEm == request.time;
        allow delete: if false;
      }

      match /eventos/{eventoId} {
        allow read: if signedIn() && exists(userPath()) && acessaMetadadosAcesso(acessoDoc(acessoId));
        allow create: if signedIn() && exists(userPath())
          && isValidEventoAcesso(request.resource.data)
          && request.resource.data.autorNome == userData().nome
          && (
            (request.resource.data.tipo in ['revelou', 'copiou'] && perfilPodeLerSegredo(userData(), acessoDoc(acessoId)))
            || (request.resource.data.tipo in ['criacao', 'atualizacao', 'permissao', 'troca_senha'] && perfilPodeEscreverSegredo(userData(), acessoDoc(acessoId)))
          );
        allow update, delete: if false;
      }
    }

    match /solicitacoesAcesso/{solicitacaoId} {
      allow read: if signedIn() && exists(userPath()) && podeLerSolicitacao(resource.data);
      allow create: if signedIn() && exists(userPath()) && isValidSolicitacaoAcesso(request.resource.data) && podeCriarSolicitacao(request.resource.data);
      allow update: if signedIn() && exists(userPath()) && resource != null && isValidSolicitacaoAcesso(request.resource.data) && podeDecidirSolicitacao();
      allow delete: if false;
    }

    // ===============================================================
    // Manuais e Processos — trilha sequencial com tempo mínimo (Módulo 4)
    // ===============================================================

    function trilhaManualPath(id) {
      return /databases/$(database)/documents/manuaisTrilha/$(id);
    }

    function progressoManualPath(id) {
      return /databases/$(database)/documents/progressoManuais/$(id);
    }

    function gereTrilhaManuais(dados) {
      return contaAtiva(dados)
        && (
          (dados.papel == 'admin')
          || (dados.papel == 'equipe_franqueadora' && temLista(dados, 'manuais'))
        );
    }

    function isValidItemTrilha(data, id) {
      return data.keys().hasOnly(['documentoId', 'titulo', 'etapa', 'ordem', 'tempoMinimoSeg', 'videoMinutos', 'anteriorId', 'ativo', 'atualizadoPor', 'atualizadoPorNome', 'atualizadoEm'])
        && data.keys().hasAll(['documentoId', 'titulo', 'etapa', 'ordem', 'tempoMinimoSeg', 'videoMinutos', 'anteriorId', 'ativo', 'atualizadoPor', 'atualizadoPorNome', 'atualizadoEm'])
        && data.documentoId == id
        && data.titulo is string && data.titulo.size() > 0 && data.titulo.size() <= 200
        && data.etapa is string && data.etapa.size() <= 80
        && data.ordem is int && data.ordem >= 1 && data.ordem <= 999
        && data.tempoMinimoSeg is int && data.tempoMinimoSeg >= 30 && data.tempoMinimoSeg <= 14400
        && data.videoMinutos is int && data.videoMinutos >= 0 && data.videoMinutos <= 600
        && data.anteriorId is string && data.anteriorId.size() <= 128 && data.anteriorId != id
        && data.ativo is bool
        && data.atualizadoPor == request.auth.uid
        && validName(data.atualizadoPorNome)
        && data.atualizadoEm == request.time;
    }

    function isValidProgressoManual(data) {
      return data.keys().hasOnly(['uid', 'documentoId', 'nome', 'unidadeId', 'unidadeNome', 'status', 'iniciadoEm', 'reinicios', 'tempoMinimoSeg', 'concluidoEm', 'atualizadoEm'])
        && data.keys().hasAll(['uid', 'documentoId', 'nome', 'unidadeId', 'unidadeNome', 'status', 'iniciadoEm', 'reinicios', 'tempoMinimoSeg', 'concluidoEm', 'atualizadoEm'])
        && data.documentoId is string && data.documentoId.size() > 0 && data.documentoId.size() <= 128
        && data.unidadeNome is string && data.unidadeNome.size() <= 120
        && data.status in ['em_andamento', 'concluido']
        && data.iniciadoEm is timestamp
        && data.reinicios is int && data.reinicios >= 0 && data.reinicios <= 100000
        && data.tempoMinimoSeg is int
        && data.atualizadoEm == request.time;
    }

    // Quem grava é sempre o próprio usuário da unidade, com o módulo liberado.
    function progressoDoProprio(dados, data, progressoId) {
      return contaAtiva(dados)
        && dados.papel in ['franqueado', 'equipe_franqueado']
        && temLista(dados, 'manuais')
        && unidadeAtiva(dados)
        && unidadeIdPreenchido(dados)
        && data.uid == request.auth.uid
        && progressoId == request.auth.uid + '_' + data.documentoId
        && data.unidadeId == dados.unidadeId
        && data.nome == dados.nome
        && data.unidadeNome == dados.get('unidade', '');
    }

    function itemTrilhaLibera(item, tempoMinimoSeg) {
      return item.ativo == true
        && item.tempoMinimoSeg == tempoMinimoSeg
        && (
          item.anteriorId == ''
          || (
            exists(progressoManualPath(request.auth.uid + '_' + item.anteriorId))
            && get(progressoManualPath(request.auth.uid + '_' + item.anteriorId)).data.status == 'concluido'
          )
        );
    }

    function leProgressoDaRede(dados) {
      return gereTrilhaManuais(dados);
    }

    function leProgressoDaUnidade(dados, unidadeId) {
      return contaAtiva(dados)
        && dados.papel == 'franqueado'
        && temLista(dados, 'manuais')
        && unidadeAtiva(dados)
        && unidadeIdPreenchido(dados)
        && dados.unidadeId == unidadeId;
    }

    match /manuaisTrilha/{id} {
      allow read: if isActive() && podeModulo('manuais');
      allow create, update: if request.resource.data.atualizadoPor == request.auth.uid ? (
          signedIn() && exists(userPath())
          && gereTrilhaManuais(userData())
          && isValidItemTrilha(request.resource.data, id)
          && request.resource.data.atualizadoPorNome == userData().nome
          && exists(/databases/$(database)/documents/documentos/$(id))
        ) : false;
      allow delete: if false;
    }

    match /progressoManuais/{progressoId} {

      // O próprio usuário lê o seu progresso, inclusive para saber que ainda não existe (id = uid_documento).
      allow get: if signedIn() && progressoId.size() > request.auth.uid.size() + 1 && progressoId[0:request.auth.uid.size() + 1] == request.auth.uid + '_'
        && (resource == null || resource.data.uid == request.auth.uid);
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
      allow read: if signedIn() && exists(userPath()) && leProgressoDaRede(userData());
      allow read: if signedIn() && exists(userPath()) && leProgressoDaUnidade(userData(), resource.data.unidadeId);

      // Início: em andamento, cronômetro começa agora no servidor, e só se o anterior foi concluído.
      allow create: if request.resource.data.status == 'em_andamento' && request.resource.data.uid == request.auth.uid ? (
          signedIn() && exists(userPath())
          && isValidProgressoManual(request.resource.data)
          && progressoDoProprio(userData(), request.resource.data, progressoId)
          && request.resource.data.iniciadoEm == request.time
          && request.resource.data.reinicios == 0
          && request.resource.data.concluidoEm == null
          && exists(trilhaManualPath(request.resource.data.documentoId))
          && itemTrilhaLibera(get(trilhaManualPath(request.resource.data.documentoId)).data, request.resource.data.tempoMinimoSeg)
        ) : false;

      // Reinício (saiu da tela ou voltou ao manual): o cronômetro do servidor recomeça.
      allow update: if resource.data.status == 'em_andamento' && request.resource.data.status == 'em_andamento' && resource.data.uid == request.auth.uid ? (
          signedIn() && exists(userPath())
          && isValidProgressoManual(request.resource.data)
          && progressoDoProprio(userData(), request.resource.data, progressoId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['iniciadoEm', 'reinicios', 'tempoMinimoSeg', 'atualizadoEm'])
          && request.resource.data.iniciadoEm == request.time
          && request.resource.data.reinicios == resource.data.reinicios + 1
          && exists(trilhaManualPath(resource.data.documentoId))
          && request.resource.data.tempoMinimoSeg == get(trilhaManualPath(resource.data.documentoId)).data.tempoMinimoSeg
        ) : false;

      // Conclusão: só depois do tempo mínimo desde o último (re)início, medido pelo servidor.
      allow update: if resource.data.status == 'em_andamento' && request.resource.data.status == 'concluido' && resource.data.uid == request.auth.uid ? (
          signedIn() && exists(userPath())
          && isValidProgressoManual(request.resource.data)
          && progressoDoProprio(userData(), request.resource.data, progressoId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'concluidoEm', 'atualizadoEm'])
          && request.resource.data.concluidoEm == request.time
          && exists(trilhaManualPath(resource.data.documentoId))
          && request.time >= resource.data.iniciadoEm + duration.value(get(trilhaManualPath(resource.data.documentoId)).data.tempoMinimoSeg, 's')
        ) : false;

      allow delete: if false;
    }

    // ===============================================================
    // Universidade UBOX — cursos, prova com gabarito protegido (Módulo 5)
    // ===============================================================
    // O gabarito (provasGabarito) só é lido pela franqueadora. As rules corrigem a
    // tentativa lendo o gabarito com get(), que não depende da permissão de leitura do aluno.

    function cursoPath(id) {
      return /databases/$(database)/documents/cursos/$(id);
    }

    function provaPath(id) {
      return /databases/$(database)/documents/provas/$(id);
    }

    function gabaritoProvaPath(id) {
      return /databases/$(database)/documents/provasGabarito/$(id);
    }

    function tentativaProvaPath(id) {
      return /databases/$(database)/documents/tentativasProva/$(id);
    }

    // Folha de respostas: subdocumento que só o dono e a franqueadora leem.
    function folhaPath(id) {
      return /databases/$(database)/documents/tentativasProva/$(id)/folha/atual;
    }

    function reestudoPath(id) {
      return /databases/$(database)/documents/reestudos/$(id);
    }

    function gereUniversidade(dados) {
      return contaAtiva(dados)
        && (
          dados.papel == 'admin'
          || (dados.papel == 'equipe_franqueadora' && temLista(dados, 'universidade'))
        );
    }

    function alunoUniversidade(dados) {
      return contaAtiva(dados)
        && dados.papel in ['franqueado', 'equipe_franqueado']
        && temLista(dados, 'universidade')
        && unidadeAtiva(dados)
        && unidadeIdPreenchido(dados);
    }

    function idCursoOk(id) {
      return id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[A-Za-z0-9-]+$');
    }

    function listaDocumentosOk(l) {
      return l is list && l.size() <= 20
        && (l.size() < 1 || (l[0] is string && l[0].size() > 0 && l[0].size() <= 128))
        && (l.size() < 2 || (l[1] is string && l[1].size() > 0 && l[1].size() <= 128))
        && (l.size() < 3 || (l[2] is string && l[2].size() > 0 && l[2].size() <= 128))
        && (l.size() < 4 || (l[3] is string && l[3].size() > 0 && l[3].size() <= 128))
        && (l.size() < 5 || (l[4] is string && l[4].size() > 0 && l[4].size() <= 128))
        && (l.size() < 6 || (l[5] is string && l[5].size() > 0 && l[5].size() <= 128))
        && (l.size() < 7 || (l[6] is string && l[6].size() > 0 && l[6].size() <= 128))
        && (l.size() < 8 || (l[7] is string && l[7].size() > 0 && l[7].size() <= 128))
        && (l.size() < 9 || (l[8] is string && l[8].size() > 0 && l[8].size() <= 128))
        && (l.size() < 10 || (l[9] is string && l[9].size() > 0 && l[9].size() <= 128))
        && (l.size() < 11 || (l[10] is string && l[10].size() > 0 && l[10].size() <= 128))
        && (l.size() < 12 || (l[11] is string && l[11].size() > 0 && l[11].size() <= 128))
        && (l.size() < 13 || (l[12] is string && l[12].size() > 0 && l[12].size() <= 128))
        && (l.size() < 14 || (l[13] is string && l[13].size() > 0 && l[13].size() <= 128))
        && (l.size() < 15 || (l[14] is string && l[14].size() > 0 && l[14].size() <= 128))
        && (l.size() < 16 || (l[15] is string && l[15].size() > 0 && l[15].size() <= 128))
        && (l.size() < 17 || (l[16] is string && l[16].size() > 0 && l[16].size() <= 128))
        && (l.size() < 18 || (l[17] is string && l[17].size() > 0 && l[17].size() <= 128))
        && (l.size() < 19 || (l[18] is string && l[18].size() > 0 && l[18].size() <= 128))
        && (l.size() < 20 || (l[19] is string && l[19].size() > 0 && l[19].size() <= 128));
    }

    function isValidCurso(data, id) {
      return data.keys().hasOnly(['titulo', 'descricao', 'ordem', 'aulas', 'publicado', 'atualizadoPor', 'atualizadoPorNome', 'atualizadoEm'])
        && data.keys().hasAll(['titulo', 'descricao', 'ordem', 'aulas', 'publicado', 'atualizadoPor', 'atualizadoPorNome', 'atualizadoEm'])
        && idCursoOk(id)
        && validName(data.titulo)
        && validShort(data.descricao, 1000)
        && data.ordem is int && data.ordem >= 1 && data.ordem <= 999
        && listaDocumentosOk(data.aulas)
        && data.publicado is bool
        && data.atualizadoPor == request.auth.uid
        && validName(data.atualizadoPorNome)
        && data.atualizadoEm == request.time;
    }

    // Pergunta pública: sem nenhum campo de resposta.
    function perguntaOk(q) {
      return q is map
        && q.keys().hasOnly(['id', 'enunciado', 'opcoes'])
        && q.id is string && q.id.size() > 0 && q.id.size() <= 40
        && q.enunciado is string && q.enunciado.size() > 0 && q.enunciado.size() <= 600
        && opcoesOk(q.opcoes);
    }

    function opcoesOk(o) {
      return o is list && o.size() >= 2 && o.size() <= 6
        && (o.size() <= 0 || (o[0] is string && o[0].size() > 0 && o[0].size() <= 300))
        && (o.size() <= 1 || (o[1] is string && o[1].size() > 0 && o[1].size() <= 300))
        && (o.size() <= 2 || (o[2] is string && o[2].size() > 0 && o[2].size() <= 300))
        && (o.size() <= 3 || (o[3] is string && o[3].size() > 0 && o[3].size() <= 300))
        && (o.size() <= 4 || (o[4] is string && o[4].size() > 0 && o[4].size() <= 300))
        && (o.size() <= 5 || (o[5] is string && o[5].size() > 0 && o[5].size() <= 300));
    }

    function perguntasOk(p) {
      return p is list && p.size() >= 1 && p.size() <= 20
        && (p.size() <= 0 || perguntaOk(p[0]))
        && (p.size() <= 1 || perguntaOk(p[1]))
        && (p.size() <= 2 || perguntaOk(p[2]))
        && (p.size() <= 3 || perguntaOk(p[3]))
        && (p.size() <= 4 || perguntaOk(p[4]))
        && (p.size() <= 5 || perguntaOk(p[5]))
        && (p.size() <= 6 || perguntaOk(p[6]))
        && (p.size() <= 7 || perguntaOk(p[7]))
        && (p.size() <= 8 || perguntaOk(p[8]))
        && (p.size() <= 9 || perguntaOk(p[9]))
        && (p.size() <= 10 || perguntaOk(p[10]))
        && (p.size() <= 11 || perguntaOk(p[11]))
        && (p.size() <= 12 || perguntaOk(p[12]))
        && (p.size() <= 13 || perguntaOk(p[13]))
        && (p.size() <= 14 || perguntaOk(p[14]))
        && (p.size() <= 15 || perguntaOk(p[15]))
        && (p.size() <= 16 || perguntaOk(p[16]))
        && (p.size() <= 17 || perguntaOk(p[17]))
        && (p.size() <= 18 || perguntaOk(p[18]))
        && (p.size() <= 19 || perguntaOk(p[19]));
    }

    function isValidProva(data, id) {
      return data.keys().hasOnly(['cursoId', 'titulo', 'notaMinima', 'perguntas', 'totalPerguntas', 'manualRetornoId', 'tempoReestudoSeg', 'versao', 'publicado', 'atualizadoPor', 'atualizadoPorNome', 'atualizadoEm'])
        && data.keys().hasAll(['cursoId', 'titulo', 'notaMinima', 'perguntas', 'totalPerguntas', 'manualRetornoId', 'tempoReestudoSeg', 'versao', 'publicado', 'atualizadoPor', 'atualizadoPorNome', 'atualizadoEm'])
        && data.cursoId == id
        && validName(data.titulo)
        && data.notaMinima is int && data.notaMinima >= 1 && data.notaMinima <= 100
        && perguntasOk(data.perguntas)
        && data.totalPerguntas == data.perguntas.size()
        && data.manualRetornoId is string && data.manualRetornoId.size() > 0 && data.manualRetornoId.size() <= 128
        && data.tempoReestudoSeg is int && data.tempoReestudoSeg >= 30 && data.tempoReestudoSeg <= 14400
        && data.versao is int && data.versao >= 1
        && data.publicado is bool
        && data.atualizadoPor == request.auth.uid
        && validName(data.atualizadoPorNome)
        && data.atualizadoEm == request.time;
    }

    function corretasOk(c) {
      return c is list && c.size() >= 1 && c.size() <= 20
        && (c.size() <= 0 || (c[0] is int && c[0] >= 0 && c[0] <= 5))
        && (c.size() <= 1 || (c[1] is int && c[1] >= 0 && c[1] <= 5))
        && (c.size() <= 2 || (c[2] is int && c[2] >= 0 && c[2] <= 5))
        && (c.size() <= 3 || (c[3] is int && c[3] >= 0 && c[3] <= 5))
        && (c.size() <= 4 || (c[4] is int && c[4] >= 0 && c[4] <= 5))
        && (c.size() <= 5 || (c[5] is int && c[5] >= 0 && c[5] <= 5))
        && (c.size() <= 6 || (c[6] is int && c[6] >= 0 && c[6] <= 5))
        && (c.size() <= 7 || (c[7] is int && c[7] >= 0 && c[7] <= 5))
        && (c.size() <= 8 || (c[8] is int && c[8] >= 0 && c[8] <= 5))
        && (c.size() <= 9 || (c[9] is int && c[9] >= 0 && c[9] <= 5))
        && (c.size() <= 10 || (c[10] is int && c[10] >= 0 && c[10] <= 5))
        && (c.size() <= 11 || (c[11] is int && c[11] >= 0 && c[11] <= 5))
        && (c.size() <= 12 || (c[12] is int && c[12] >= 0 && c[12] <= 5))
        && (c.size() <= 13 || (c[13] is int && c[13] >= 0 && c[13] <= 5))
        && (c.size() <= 14 || (c[14] is int && c[14] >= 0 && c[14] <= 5))
        && (c.size() <= 15 || (c[15] is int && c[15] >= 0 && c[15] <= 5))
        && (c.size() <= 16 || (c[16] is int && c[16] >= 0 && c[16] <= 5))
        && (c.size() <= 17 || (c[17] is int && c[17] >= 0 && c[17] <= 5))
        && (c.size() <= 18 || (c[18] is int && c[18] >= 0 && c[18] <= 5))
        && (c.size() <= 19 || (c[19] is int && c[19] >= 0 && c[19] <= 5));
    }

    function isValidGabarito(data, id) {
      return data.keys().hasOnly(['cursoId', 'corretas', 'versao', 'atualizadoPor', 'atualizadoEm'])
        && data.keys().hasAll(['cursoId', 'corretas', 'versao', 'atualizadoPor', 'atualizadoEm'])
        && data.cursoId == id
        && corretasOk(data.corretas)
        && data.versao is int && data.versao >= 1
        && data.atualizadoPor == request.auth.uid
        && data.atualizadoEm == request.time;
    }

    function respostasOk(r, total) {
      return r is list && r.size() == total && r.size() <= 20
        && (r.size() <= 0 || (r[0] is int && r[0] >= 0 && r[0] <= 5))
        && (r.size() <= 1 || (r[1] is int && r[1] >= 0 && r[1] <= 5))
        && (r.size() <= 2 || (r[2] is int && r[2] >= 0 && r[2] <= 5))
        && (r.size() <= 3 || (r[3] is int && r[3] >= 0 && r[3] <= 5))
        && (r.size() <= 4 || (r[4] is int && r[4] >= 0 && r[4] <= 5))
        && (r.size() <= 5 || (r[5] is int && r[5] >= 0 && r[5] <= 5))
        && (r.size() <= 6 || (r[6] is int && r[6] >= 0 && r[6] <= 5))
        && (r.size() <= 7 || (r[7] is int && r[7] >= 0 && r[7] <= 5))
        && (r.size() <= 8 || (r[8] is int && r[8] >= 0 && r[8] <= 5))
        && (r.size() <= 9 || (r[9] is int && r[9] >= 0 && r[9] <= 5))
        && (r.size() <= 10 || (r[10] is int && r[10] >= 0 && r[10] <= 5))
        && (r.size() <= 11 || (r[11] is int && r[11] >= 0 && r[11] <= 5))
        && (r.size() <= 12 || (r[12] is int && r[12] >= 0 && r[12] <= 5))
        && (r.size() <= 13 || (r[13] is int && r[13] >= 0 && r[13] <= 5))
        && (r.size() <= 14 || (r[14] is int && r[14] >= 0 && r[14] <= 5))
        && (r.size() <= 15 || (r[15] is int && r[15] >= 0 && r[15] <= 5))
        && (r.size() <= 16 || (r[16] is int && r[16] >= 0 && r[16] <= 5))
        && (r.size() <= 17 || (r[17] is int && r[17] >= 0 && r[17] <= 5))
        && (r.size() <= 18 || (r[18] is int && r[18] >= 0 && r[18] <= 5))
        && (r.size() <= 19 || (r[19] is int && r[19] >= 0 && r[19] <= 5));
    }

    // Quantas respostas batem com o gabarito (desenrolado até 20 questões).
    function contarAcertos(r, c) {
      return (c.size() > 0 && r[0] == c[0] ? 1 : 0)
        + (c.size() > 1 && r[1] == c[1] ? 1 : 0)
        + (c.size() > 2 && r[2] == c[2] ? 1 : 0)
        + (c.size() > 3 && r[3] == c[3] ? 1 : 0)
        + (c.size() > 4 && r[4] == c[4] ? 1 : 0)
        + (c.size() > 5 && r[5] == c[5] ? 1 : 0)
        + (c.size() > 6 && r[6] == c[6] ? 1 : 0)
        + (c.size() > 7 && r[7] == c[7] ? 1 : 0)
        + (c.size() > 8 && r[8] == c[8] ? 1 : 0)
        + (c.size() > 9 && r[9] == c[9] ? 1 : 0)
        + (c.size() > 10 && r[10] == c[10] ? 1 : 0)
        + (c.size() > 11 && r[11] == c[11] ? 1 : 0)
        + (c.size() > 12 && r[12] == c[12] ? 1 : 0)
        + (c.size() > 13 && r[13] == c[13] ? 1 : 0)
        + (c.size() > 14 && r[14] == c[14] ? 1 : 0)
        + (c.size() > 15 && r[15] == c[15] ? 1 : 0)
        + (c.size() > 16 && r[16] == c[16] ? 1 : 0)
        + (c.size() > 17 && r[17] == c[17] ? 1 : 0)
        + (c.size() > 18 && r[18] == c[18] ? 1 : 0)
        + (c.size() > 19 && r[19] == c[19] ? 1 : 0);
    }

    function idTentativa(cursoId, ciclo, numero) {
      return request.auth.uid + '_' + cursoId + '_' + string(ciclo) + '_' + string(numero);
    }

    function tentativaReprovada(id) {
      return exists(tentativaProvaPath(id)) && get(tentativaProvaPath(id)).data.aprovado == false;
    }

    // Sequência: até 3 chances por ciclo; um ciclo novo só depois de reprovar a 3ª e reestudar o manual.
    function tentativaNaVez(d) {
      return (d.numero == 1 && d.ciclo == 1)
        || (d.numero > 1 && tentativaReprovada(idTentativa(d.cursoId, d.ciclo, d.numero - 1)))
        || (
          d.numero == 1 && d.ciclo > 1
          && tentativaReprovada(idTentativa(d.cursoId, d.ciclo - 1, 3))
          && exists(reestudoPath(request.auth.uid + '_' + d.cursoId + '_' + string(d.ciclo - 1)))
          && get(reestudoPath(request.auth.uid + '_' + d.cursoId + '_' + string(d.ciclo - 1))).data.status == 'concluido'
        );
    }

    function isValidTentativaProva(d) {
      return d.keys().hasOnly(['uid', 'cursoId', 'ciclo', 'numero', 'nome', 'unidadeId', 'unidadeNome', 'versao', 'aprovado', 'criadoEm', 'corrigidoEm'])
        && d.keys().hasAll(['uid', 'cursoId', 'ciclo', 'numero', 'nome', 'unidadeId', 'unidadeNome', 'versao', 'aprovado', 'criadoEm', 'corrigidoEm'])
        && idCursoOk(d.cursoId)
        && d.ciclo is int && d.ciclo >= 1 && d.ciclo <= 50
        && d.numero is int && d.numero >= 1 && d.numero <= 3
        && d.versao is int
        && d.unidadeNome is string && d.unidadeNome.size() <= 120;
    }

    function alunoConfere(dados, d) {
      return alunoUniversidade(dados)
        && d.nome == dados.nome
        && d.unidadeId == dados.unidadeId
        && d.unidadeNome == dados.get('unidade', '');
    }

    function provaAceita(prova, d) {
      return prova.publicado == true
        && d.versao == prova.versao;
    }

    // Correção feita pelas rules: aprovado precisa bater com a conta sobre o gabarito.
    // Se a prova ganhou versão nova entre o envio e a correção, a tentativa só fecha como reprovada (perde a chance).
    function correcaoConfere(antes, depois, prova, gabarito, folha) {
      return gabarito.versao == antes.versao
        ? depois.aprovado == (contarAcertos(folha.respostas, gabarito.corretas) * 100 >= prova.notaMinima * prova.totalPerguntas)
        : depois.aprovado == false;
    }

    function leResultadoUnidade(dados, unidadeId) {
      return contaAtiva(dados)
        && dados.papel == 'franqueado'
        && temLista(dados, 'universidade')
        && unidadeAtiva(dados)
        && unidadeIdPreenchido(dados)
        && dados.unidadeId == unidadeId;
    }

    match /cursos/{cursoId} {
      allow read: if isActive() && podeModulo('universidade') && resource.data.publicado == true;
      allow read: if signedIn() && exists(userPath()) && gereUniversidade(userData());
      allow create, update: if request.resource.data.atualizadoPor == request.auth.uid ? (
          signedIn() && exists(userPath())
          && gereUniversidade(userData())
          && isValidCurso(request.resource.data, cursoId)
          && request.resource.data.atualizadoPorNome == userData().nome
        ) : false;
      allow delete: if false;
    }

    match /provas/{cursoId} {
      allow read: if isActive() && podeModulo('universidade') && resource.data.publicado == true;
      allow read: if signedIn() && exists(userPath()) && gereUniversidade(userData());
      // Prova e gabarito sobem juntos no mesmo lote, com a mesma versão.
      allow create, update: if request.resource.data.atualizadoPor == request.auth.uid ? (
          signedIn() && exists(userPath())
          && gereUniversidade(userData())
          && isValidProva(request.resource.data, cursoId)
          && request.resource.data.atualizadoPorNome == userData().nome
          && (resource == null || request.resource.data.versao == resource.data.versao + 1)
          && exists(cursoPath(cursoId))
          && existsAfter(gabaritoProvaPath(cursoId))
          && getAfter(gabaritoProvaPath(cursoId)).data.versao == request.resource.data.versao
          && getAfter(gabaritoProvaPath(cursoId)).data.corretas.size() == request.resource.data.totalPerguntas
        ) : false;
      allow delete: if false;
    }

    match /provasGabarito/{cursoId} {
      // Nunca legível pelo aluno.
      allow read: if signedIn() && exists(userPath()) && gereUniversidade(userData());
      allow create, update: if request.resource.data.atualizadoPor == request.auth.uid ? (
          signedIn() && exists(userPath())
          && gereUniversidade(userData())
          && isValidGabarito(request.resource.data, cursoId)
          && existsAfter(provaPath(cursoId))
          && getAfter(provaPath(cursoId)).data.versao == request.resource.data.versao
        ) : false;
      allow delete: if false;
    }

    match /tentativasProva/{tentativaId} {
      allow get: if signedIn() && tentativaId.size() > request.auth.uid.size() + 1
        && tentativaId[0:request.auth.uid.size() + 1] == request.auth.uid + '_'
        && (resource == null || resource.data.uid == request.auth.uid);
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
      allow read: if signedIn() && exists(userPath()) && gereUniversidade(userData());
      allow read: if signedIn() && exists(userPath()) && leResultadoUnidade(userData(), resource.data.unidadeId);

      // Envio: grava as respostas e ocupa a chance. Sem resultado ainda, para que uma recusa não sirva de "oráculo".
      allow create: if request.resource.data.uid == request.auth.uid && request.resource.data.aprovado == null ? (
          signedIn() && exists(userPath())
          && isValidTentativaProva(request.resource.data)
          && tentativaId == idTentativa(request.resource.data.cursoId, request.resource.data.ciclo, request.resource.data.numero)
          && request.resource.data.corrigidoEm == null
          && request.resource.data.criadoEm == request.time
          && alunoConfere(userData(), request.resource.data)
          && exists(provaPath(request.resource.data.cursoId))
          && provaAceita(get(provaPath(request.resource.data.cursoId)).data, request.resource.data)
          && existsAfter(folhaPath(tentativaId))
          && tentativaNaVez(request.resource.data)
        ) : false;

      // Correção: só o resultado muda, uma vez, e precisa bater com o gabarito.
      allow update: if resource.data.uid == request.auth.uid && resource.data.aprovado == null && request.resource.data.aprovado is bool ? (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aprovado', 'corrigidoEm'])
          && request.resource.data.corrigidoEm == request.time
          && exists(gabaritoProvaPath(resource.data.cursoId))
          && correcaoConfere(resource.data, request.resource.data, get(provaPath(resource.data.cursoId)).data, get(gabaritoProvaPath(resource.data.cursoId)).data, get(folhaPath(tentativaId)).data)
        ) : false;

      // A franqueadora pode fechar como reprovada uma tentativa que ficou sem correção.
      allow update: if resource.data.aprovado == null && request.resource.data.aprovado == false ? (
          signedIn() && exists(userPath())
          && gereUniversidade(userData())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aprovado', 'corrigidoEm'])
          && request.resource.data.corrigidoEm == request.time
        ) : false;
      allow delete: if false;

      // Folha de respostas: nasce no mesmo lote da tentativa e nunca muda.
      // O franqueado lê o resultado da equipe no doc pai, mas não a folha (senão reconstruiria o gabarito).
      match /folha/{folhaId} {
        allow read: if signedIn() && resource.data.uid == request.auth.uid;
        allow read: if signedIn() && exists(userPath()) && gereUniversidade(userData());
        allow create: if request.resource.data.uid == request.auth.uid && folhaId == 'atual' ? (
            request.resource.data.keys().hasOnly(['uid', 'versao', 'respostas'])
            && request.resource.data.keys().hasAll(['uid', 'versao', 'respostas'])
            && tentativaId.size() > request.auth.uid.size() + 1
            && tentativaId[0:request.auth.uid.size() + 1] == request.auth.uid + '_'
            && !exists(tentativaProvaPath(tentativaId))
            && existsAfter(tentativaProvaPath(tentativaId))
            && getAfter(tentativaProvaPath(tentativaId)).data.uid == request.auth.uid
            && getAfter(tentativaProvaPath(tentativaId)).data.versao == request.resource.data.versao
            && respostasOk(request.resource.data.respostas, get(provaPath(getAfter(tentativaProvaPath(tentativaId)).data.cursoId)).data.totalPerguntas)
          ) : false;
        allow update, delete: if false;
      }
    }

    // Reestudo do manual depois de reprovar nas 3 chances: libera o próximo ciclo.
    match /reestudos/{reestudoId} {
      allow get: if signedIn() && reestudoId.size() > request.auth.uid.size() + 1
        && reestudoId[0:request.auth.uid.size() + 1] == request.auth.uid + '_'
        && (resource == null || resource.data.uid == request.auth.uid);
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
      allow read: if signedIn() && exists(userPath()) && gereUniversidade(userData());

      allow create: if request.resource.data.uid == request.auth.uid && request.resource.data.status == 'em_andamento' ? (
          signedIn() && exists(userPath())
          && request.resource.data.keys().hasOnly(['uid', 'cursoId', 'ciclo', 'documentoId', 'status', 'iniciadoEm', 'reinicios', 'concluidoEm', 'atualizadoEm'])
          && request.resource.data.keys().hasAll(['uid', 'cursoId', 'ciclo', 'documentoId', 'status', 'iniciadoEm', 'reinicios', 'concluidoEm', 'atualizadoEm'])
          && idCursoOk(request.resource.data.cursoId)
          && request.resource.data.ciclo is int && request.resource.data.ciclo >= 1 && request.resource.data.ciclo <= 50
          && reestudoId == request.auth.uid + '_' + request.resource.data.cursoId + '_' + string(request.resource.data.ciclo)
          && request.resource.data.iniciadoEm == request.time
          && request.resource.data.reinicios == 0
          && request.resource.data.concluidoEm == null
          && request.resource.data.atualizadoEm == request.time
          && alunoUniversidade(userData())
          && exists(provaPath(request.resource.data.cursoId))
          && request.resource.data.documentoId == get(provaPath(request.resource.data.cursoId)).data.manualRetornoId
          && tentativaReprovada(idTentativa(request.resource.data.cursoId, request.resource.data.ciclo, 3))
        ) : false;

      allow update: if resource.data.uid == request.auth.uid && resource.data.status == 'em_andamento' && request.resource.data.status == 'em_andamento' ? (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['iniciadoEm', 'reinicios', 'atualizadoEm'])
          && request.resource.data.iniciadoEm == request.time
          && request.resource.data.reinicios == resource.data.reinicios + 1
          && request.resource.data.atualizadoEm == request.time
        ) : false;

      allow update: if resource.data.uid == request.auth.uid && resource.data.status == 'em_andamento' && request.resource.data.status == 'concluido' ? (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'concluidoEm', 'atualizadoEm'])
          && request.resource.data.concluidoEm == request.time
          && request.resource.data.atualizadoEm == request.time
          && exists(provaPath(resource.data.cursoId))
          && request.time >= resource.data.iniciadoEm + duration.value(get(provaPath(resource.data.cursoId)).data.tempoReestudoSeg, 's')
        ) : false;
      allow delete: if false;
    }

    // ===============================================================
    // Central de Marketing (Módulo 6)
    // ===============================================================
    // Materiais ficam fora do Firebase (Drive ou outro link https): Spark, sem Cloud Storage.

    function gereMarketing(dados) {
      return contaAtiva(dados)
        && (
          dados.papel == 'admin'
          || (dados.papel == 'equipe_franqueadora' && temLista(dados, 'marketing'))
        );
    }

    function unidadeMarketing(dados) {
      return contaAtiva(dados)
        && dados.papel in ['franqueado', 'equipe_franqueado']
        && temLista(dados, 'marketing')
        && unidadeAtiva(dados)
        && unidadeIdPreenchido(dados);
    }

    function linkHttps(v, opcional) {
      return v is string && v.size() <= 600
        && ((opcional && v == '') || v.matches('^https://[^\\s]+$'));
    }

    function listaUnidadesOk(l) {
      return l is list && l.size() <= 30
        && (l.size() <= 0 || (l[0] is string && l[0].size() > 0 && l[0].size() <= 64))
        && (l.size() <= 1 || (l[1] is string && l[1].size() > 0 && l[1].size() <= 64))
        && (l.size() <= 2 || (l[2] is string && l[2].size() > 0 && l[2].size() <= 64))
        && (l.size() <= 3 || (l[3] is string && l[3].size() > 0 && l[3].size() <= 64))
        && (l.size() <= 4 || (l[4] is string && l[4].size() > 0 && l[4].size() <= 64))
        && (l.size() <= 5 || (l[5] is string && l[5].size() > 0 && l[5].size() <= 64))
        && (l.size() <= 6 || (l[6] is string && l[6].size() > 0 && l[6].size() <= 64))
        && (l.size() <= 7 || (l[7] is string && l[7].size() > 0 && l[7].size() <= 64))
        && (l.size() <= 8 || (l[8] is string && l[8].size() > 0 && l[8].size() <= 64))
        && (l.size() <= 9 || (l[9] is string && l[9].size() > 0 && l[9].size() <= 64))
        && (l.size() <= 10 || (l[10] is string && l[10].size() > 0 && l[10].size() <= 64))
        && (l.size() <= 11 || (l[11] is string && l[11].size() > 0 && l[11].size() <= 64))
        && (l.size() <= 12 || (l[12] is string && l[12].size() > 0 && l[12].size() <= 64))
        && (l.size() <= 13 || (l[13] is string && l[13].size() > 0 && l[13].size() <= 64))
        && (l.size() <= 14 || (l[14] is string && l[14].size() > 0 && l[14].size() <= 64))
        && (l.size() <= 15 || (l[15] is string && l[15].size() > 0 && l[15].size() <= 64))
        && (l.size() <= 16 || (l[16] is string && l[16].size() > 0 && l[16].size() <= 64))
        && (l.size() <= 17 || (l[17] is string && l[17].size() > 0 && l[17].size() <= 64))
        && (l.size() <= 18 || (l[18] is string && l[18].size() > 0 && l[18].size() <= 64))
        && (l.size() <= 19 || (l[19] is string && l[19].size() > 0 && l[19].size() <= 64))
        && (l.size() <= 20 || (l[20] is string && l[20].size() > 0 && l[20].size() <= 64))
        && (l.size() <= 21 || (l[21] is string && l[21].size() > 0 && l[21].size() <= 64))
        && (l.size() <= 22 || (l[22] is string && l[22].size() > 0 && l[22].size() <= 64))
        && (l.size() <= 23 || (l[23] is string && l[23].size() > 0 && l[23].size() <= 64))
        && (l.size() <= 24 || (l[24] is string && l[24].size() > 0 && l[24].size() <= 64))
        && (l.size() <= 25 || (l[25] is string && l[25].size() > 0 && l[25].size() <= 64))
        && (l.size() <= 26 || (l[26] is string && l[26].size() > 0 && l[26].size() <= 64))
        && (l.size() <= 27 || (l[27] is string && l[27].size() > 0 && l[27].size() <= 64))
        && (l.size() <= 28 || (l[28] is string && l[28].size() > 0 && l[28].size() <= 64))
        && (l.size() <= 29 || (l[29] is string && l[29].size() > 0 && l[29].size() <= 64));
    }

    function dataOpcional(v) {
      return v == null || v is timestamp;
    }

    function iaOk(data) {
      return data.geradoPorIA is bool
        && data.iaModelo is string && data.iaModelo.size() <= 80
        && (data.geradoPorIA == false || (data.iaModelo.size() >= 2 && data.iaModelo.matches('.*\\S.*')));
    }

    function autoriaMarketing(data, dados) {
      return data.atualizadoPor == request.auth.uid
        && data.atualizadoPorNome == dados.nome
        && data.atualizadoEm == request.time;
    }

    function isValidMaterial(data) {
      return data.keys().hasOnly(['titulo', 'descricao', 'tipo', 'categoria', 'campanhaId', 'url', 'previaUrl', 'formato', 'regrasUso', 'validoDe', 'validoAte', 'publico', 'unidades', 'ativo', 'geradoPorIA', 'iaModelo', 'criadoEm', 'atualizadoPor', 'atualizadoPorNome', 'atualizadoEm'])
        && data.keys().hasAll(['titulo', 'descricao', 'tipo', 'categoria', 'campanhaId', 'url', 'previaUrl', 'formato', 'regrasUso', 'validoDe', 'validoAte', 'publico', 'unidades', 'ativo', 'geradoPorIA', 'iaModelo', 'criadoEm', 'atualizadoPor', 'atualizadoPorNome', 'atualizadoEm'])
        && validName(data.titulo)
        && validShort(data.descricao, 1000)
        && data.tipo in ['arte', 'campanha', 'logo', 'marca', 'template', 'video', 'outro']
        && validShort(data.categoria, 60)
        && validShort(data.campanhaId, 64)
        && linkHttps(data.url, false)
        && linkHttps(data.previaUrl, true)
        && validShort(data.formato, 40)
        && validShort(data.regrasUso, 1000)
        && dataOpcional(data.validoDe)
        && dataOpcional(data.validoAte)
        && data.publico is bool
        && listaUnidadesOk(data.unidades)
        && (data.publico == true ? data.unidades.size() == 0 : data.unidades.size() > 0)
        && data.ativo is bool
        && iaOk(data)
        && data.criadoEm is timestamp;
    }

    function isValidCampanhaMkt(data) {
      return data.keys().hasOnly(['titulo', 'descricao', 'tipo', 'inicio', 'fim', 'ativo', 'geradoPorIA', 'iaModelo', 'atualizadoPor', 'atualizadoPorNome', 'atualizadoEm'])
        && data.keys().hasAll(['titulo', 'descricao', 'tipo', 'inicio', 'fim', 'ativo', 'geradoPorIA', 'iaModelo', 'atualizadoPor', 'atualizadoPorNome', 'atualizadoEm'])
        && validName(data.titulo)
        && validShort(data.descricao, 1000)
        && data.tipo in ['campanha', 'data_comemorativa', 'lancamento']
        && data.inicio is timestamp
        && data.fim is timestamp
        && data.fim >= data.inicio
        && data.ativo is bool
        && iaOk(data);
    }

    match /marketingMateriais/{materialId} {
      allow read: if signedIn() && exists(userPath()) && gereMarketing(userData());
      // Unidade: só materiais ativos, para a rede toda ou para a própria unidade.
      allow read: if resource.data.ativo == true && resource.data.publico == true ? (
          signedIn() && exists(userPath()) && unidadeMarketing(userData())
        ) : false;
      allow read: if resource.data.ativo == true ? (
          signedIn() && exists(userPath()) && unidadeMarketing(userData())
          && userData().unidadeId in resource.data.unidades
        ) : false;
      allow create, update: if request.resource.data.atualizadoPor == request.auth.uid ? (
          signedIn() && exists(userPath())
          && gereMarketing(userData())
          && isValidMaterial(request.resource.data)
          && autoriaMarketing(request.resource.data, userData())
          && (resource == null || request.resource.data.criadoEm == resource.data.criadoEm)
          && (resource != null || request.resource.data.criadoEm == request.time)
        ) : false;
      allow delete: if false;
    }

    match /marketingCampanhas/{campanhaId} {
      allow read: if signedIn() && exists(userPath()) && gereMarketing(userData());
      allow read: if resource.data.ativo == true ? (
          signedIn() && exists(userPath()) && unidadeMarketing(userData())
        ) : false;
      allow create, update: if request.resource.data.atualizadoPor == request.auth.uid ? (
          signedIn() && exists(userPath())
          && gereMarketing(userData())
          && isValidCampanhaMkt(request.resource.data)
          && autoriaMarketing(request.resource.data, userData())
        ) : false;
      allow delete: if false;
    }

    // Pedido de peça da unidade para a franqueadora.
    function isValidSolicitacaoMkt(data) {
      return data.keys().hasOnly(['uid', 'nome', 'unidadeId', 'unidadeNome', 'titulo', 'tipoPeca', 'descricao', 'medidas', 'prazoDesejado', 'referenciaUrl', 'campanhaId', 'status', 'complemento', 'resposta', 'entregaUrl', 'geradoPorIA', 'iaModelo', 'responsavelNome', 'criadoEm', 'atualizadoEm', 'entregueEm'])
        && data.keys().hasAll(['uid', 'nome', 'unidadeId', 'unidadeNome', 'titulo', 'tipoPeca', 'descricao', 'medidas', 'prazoDesejado', 'referenciaUrl', 'campanhaId', 'status', 'complemento', 'resposta', 'entregaUrl', 'geradoPorIA', 'iaModelo', 'responsavelNome', 'criadoEm', 'atualizadoEm', 'entregueEm'])
        && data.status in ['aberta', 'em_producao', 'aguardando_unidade', 'entregue', 'cancelada']
        && validShort(data.complemento, 2000)
        && validShort(data.resposta, 2000)
        && linkHttps(data.entregaUrl, true)
        && iaOk(data)
        && validShort(data.responsavelNome, 120)
        && data.atualizadoEm == request.time;
    }

    function solicitacaoNovaOk(data, dados) {
      return data.uid == request.auth.uid
        && data.nome == dados.nome
        && data.unidadeId == dados.unidadeId
        && data.unidadeNome == dados.get('unidade', '')
        && validName(data.titulo)
        && data.tipoPeca in ['post', 'story', 'banner', 'panfleto', 'fachada', 'video', 'outro']
        && data.descricao is string && data.descricao.size() >= 10 && data.descricao.size() <= 2000
        && validShort(data.medidas, 120)
        && dataOpcional(data.prazoDesejado)
        && linkHttps(data.referenciaUrl, true)
        && validShort(data.campanhaId, 64)
        && data.complemento == ''
        && data.resposta == ''
        && data.entregaUrl == ''
        && data.geradoPorIA == false
        && data.iaModelo == ''
        && data.responsavelNome == ''
        && data.criadoEm == request.time
        && data.entregueEm == null;
    }

    function daUnidadeMkt(dados, unidadeId) {
      return unidadeMarketing(dados) && dados.unidadeId == unidadeId;
    }

    match /marketingSolicitacoes/{solicitacaoId} {
      allow read: if signedIn() && exists(userPath()) && gereMarketing(userData());
      // Quem pediu lê o próprio pedido; o franqueado lê os pedidos da unidade.
      allow read: if resource.data.uid == request.auth.uid ? (
          signedIn() && exists(userPath()) && unidadeMarketing(userData())
        ) : false;
      allow read: if signedIn() && exists(userPath())
        && userData().papel == 'franqueado'
        && daUnidadeMkt(userData(), resource.data.unidadeId);

      allow create: if request.resource.data.uid == request.auth.uid && request.resource.data.status == 'aberta' ? (
          signedIn() && exists(userPath())
          && unidadeMarketing(userData())
          && isValidSolicitacaoMkt(request.resource.data)
          && solicitacaoNovaOk(request.resource.data, userData())
        ) : false;

      // Franqueadora: andamento, resposta e entrega (com link e registro de IA).
      allow update: if request.resource.data.status != resource.data.status || request.resource.data.resposta != resource.data.resposta ? (
          signedIn() && exists(userPath())
          && gereMarketing(userData())
          && resource.data.status in ['aberta', 'em_producao', 'aguardando_unidade']
          && request.resource.data.status in ['em_producao', 'aguardando_unidade', 'entregue', 'cancelada']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resposta', 'entregaUrl', 'geradoPorIA', 'iaModelo', 'responsavelNome', 'atualizadoEm', 'entregueEm'])
          && isValidSolicitacaoMkt(request.resource.data)
          && request.resource.data.responsavelNome == userData().nome
          && (request.resource.data.status == 'entregue'
            ? (request.resource.data.entregaUrl.size() > 0 && request.resource.data.entregueEm == request.time)
            : request.resource.data.entregueEm == null)
        ) : false;

      // Unidade: cancela enquanto não começou, ou responde quando a franqueadora pediu informação.
      allow update: if (request.resource.data.status == 'cancelada' && resource.data.status == 'aberta')
          || (request.resource.data.status == 'aberta' && resource.data.status == 'aguardando_unidade') ? (
          signedIn() && exists(userPath())
          && daUnidadeMkt(userData(), resource.data.unidadeId)
          && (resource.data.uid == request.auth.uid || userData().papel == 'franqueado')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'complemento', 'atualizadoEm'])
          && (request.resource.data.status == 'cancelada'
            || (request.resource.data.complemento.size() >= 2 && request.resource.data.complemento != resource.data.complemento))
          && isValidSolicitacaoMkt(request.resource.data)
        ) : false;
      allow delete: if false;
    }

    // ===== Módulo 7: Checklist Operacional =====
    function gereChecklist(dados) {
      return contaAtiva(dados)
        && (
          dados.papel == 'admin'
          || (dados.papel == 'equipe_franqueadora' && temLista(dados, 'checklist'))
        );
    }

    function unidadeChecklist(dados) {
      return contaAtiva(dados)
        && dados.papel in ['franqueado', 'equipe_franqueado']
        && temLista(dados, 'checklist')
        && unidadeAtiva(dados)
        && unidadeIdPreenchido(dados);
    }

    function isValidModeloChecklist(data) {
      return data.keys().hasOnly(['titulo', 'descricao', 'tipo', 'frequencia', 'itens', 'totalItens', 'pesoTotal', 'versao', 'publico', 'unidades', 'ativo', 'geradoPorIA', 'iaModelo', 'criadoEm', 'atualizadoPor', 'atualizadoPorNome', 'atualizadoEm'])
        && data.keys().hasAll(['titulo', 'descricao', 'tipo', 'frequencia', 'itens', 'totalItens', 'pesoTotal', 'versao', 'publico', 'unidades', 'ativo', 'geradoPorIA', 'iaModelo', 'criadoEm', 'atualizadoPor', 'atualizadoPorNome', 'atualizadoEm'])
        && validName(data.titulo)
        && validShort(data.descricao, 1000)
        && data.tipo in ['abertura', 'fechamento', 'limpeza', 'inauguracao', 'vistoria', 'outro']
        && data.frequencia in ['diaria', 'semanal', 'mensal', 'avulsa']
        && data.itens is list && data.itens.size() >= 1 && data.itens.size() <= 60
        && data.totalItens == data.itens.size()
        && data.pesoTotal is int && data.pesoTotal >= data.totalItens && data.pesoTotal <= data.totalItens * 10
        && data.versao is int && data.versao >= 1
        && data.publico is bool
        && listaUnidadesOk(data.unidades)
        && (data.publico == true ? data.unidades.size() == 0 : data.unidades.size() > 0)
        && data.ativo is bool
        && iaOk(data)
        && data.criadoEm is timestamp
        && data.atualizadoPor == request.auth.uid
        && data.atualizadoEm == request.time;
    }

    // Totais coerentes entre si e com o modelo (a soma item a item fica no cliente).
    function totaisChecklistOk(data, modelo) {
      return data.qtdOk is int && data.qtdNaoOk is int && data.qtdNa is int
        && data.qtdOk >= 0 && data.qtdNaoOk >= 0 && data.qtdNa >= 0
        && data.qtdOk + data.qtdNaoOk + data.qtdNa == data.totalItens
        && data.pontosPossiveis is int && data.pontosObtidos is int
        && data.pontosObtidos >= data.qtdOk
        && data.pontosPossiveis - data.pontosObtidos >= data.qtdNaoOk
        && data.pontosPossiveis <= modelo.pesoTotal
        && data.pontosPossiveis <= (data.qtdOk + data.qtdNaoOk) * 10
        && data.pontosObtidos <= data.qtdOk * 10
        && (data.qtdNaoOk == 0) == (data.pontosObtidos == data.pontosPossiveis)
        && data.score is int
        && (data.pontosPossiveis == 0
          ? data.score == 100
          : data.score == math.floor(data.pontosObtidos * 100 / data.pontosPossiveis));
    }

    function execucaoNovaOk(data, dados) {
      return data.keys().hasOnly(['modeloId', 'modeloTitulo', 'modeloVersao', 'tipo', 'frequencia', 'unidadeId', 'unidadeNome', 'uid', 'nome', 'respostas', 'totalItens', 'qtdOk', 'qtdNaoOk', 'qtdNa', 'pontosObtidos', 'pontosPossiveis', 'score', 'obsGeral', 'obsProprietario', 'obsProprietarioPor', 'obsProprietarioNome', 'obsProprietarioEm', 'criadoEm'])
        && data.keys().hasAll(['modeloId', 'modeloTitulo', 'modeloVersao', 'tipo', 'frequencia', 'unidadeId', 'unidadeNome', 'uid', 'nome', 'respostas', 'totalItens', 'qtdOk', 'qtdNaoOk', 'qtdNa', 'pontosObtidos', 'pontosPossiveis', 'score', 'obsGeral', 'obsProprietario', 'obsProprietarioPor', 'obsProprietarioNome', 'obsProprietarioEm', 'criadoEm'])
        && data.nome == dados.nome
        && data.unidadeId == dados.unidadeId
        && data.unidadeNome == dados.get('unidade', '')
        && data.modeloId is string && data.modeloId.size() > 0 && data.modeloId.size() <= 64
        && data.respostas is list
        && validShort(data.obsGeral, 2000)
        && data.obsProprietario == ''
        && data.obsProprietarioPor == ''
        && data.obsProprietarioNome == ''
        && data.obsProprietarioEm == null
        && data.criadoEm == request.time;
    }

    function modeloServeExecucao(data, modelo) {
      return modelo.ativo == true
        && (modelo.publico == true || data.unidadeId in modelo.unidades)
        && data.modeloVersao == modelo.versao
        && data.modeloTitulo == modelo.titulo
        && data.tipo == modelo.tipo
        && data.frequencia == modelo.frequencia
        && data.totalItens == modelo.totalItens
        && data.respostas.size() == modelo.totalItens;
    }

    match /checklistModelos/{modeloId} {
      allow read: if signedIn() && exists(userPath()) && gereChecklist(userData());
      // Unidade: só modelos ativos, da rede toda ou direcionados à própria unidade.
      allow read: if resource.data.ativo == true && resource.data.publico == true ? (
          signedIn() && exists(userPath()) && unidadeChecklist(userData())
        ) : false;
      allow read: if resource.data.ativo == true ? (
          signedIn() && exists(userPath()) && unidadeChecklist(userData())
          && userData().unidadeId in resource.data.unidades
        ) : false;
      allow create: if request.resource.data.atualizadoPor == request.auth.uid ? (
          signedIn() && exists(userPath())
          && gereChecklist(userData())
          && isValidModeloChecklist(request.resource.data)
          && request.resource.data.atualizadoPorNome == userData().nome
          && request.resource.data.versao == 1
          && request.resource.data.criadoEm == request.time
        ) : false;
      // Edição: itens, título, tipo, frequência ou peso total novos sobem a versão (execuções antigas guardam a versão que usaram).
      allow update: if request.resource.data.atualizadoPor == request.auth.uid ? (
          signedIn() && exists(userPath())
          && gereChecklist(userData())
          && isValidModeloChecklist(request.resource.data)
          && request.resource.data.atualizadoPorNome == userData().nome
          && request.resource.data.criadoEm == resource.data.criadoEm
          && request.resource.data.versao == (
            request.resource.data.itens == resource.data.itens
              && request.resource.data.titulo == resource.data.titulo
              && request.resource.data.tipo == resource.data.tipo
              && request.resource.data.frequencia == resource.data.frequencia
              && request.resource.data.pesoTotal == resource.data.pesoTotal
              ? resource.data.versao : resource.data.versao + 1)
        ) : false;
      allow delete: if false;
    }

    match /checklistExecucoes/{execucaoId} {
      allow read: if signedIn() && exists(userPath()) && gereChecklist(userData());
      // Auditoria (Módulo 8): o auditor lê execuções para referenciar e recalcular o score.
      allow read: if signedIn() && exists(userPath()) && gereAuditoria(userData());
      // Unidade: o histórico da própria unidade.
      allow read: if signedIn() && exists(userPath())
        && unidadeChecklist(userData())
        && resource.data.unidadeId == userData().unidadeId;

      allow create: if request.resource.data.uid == request.auth.uid
          && exists(/databases/$(database)/documents/checklistModelos/$(request.resource.data.modeloId)) ? (
          signedIn() && exists(userPath())
          && unidadeChecklist(userData())
          && execucaoNovaOk(request.resource.data, userData())
          && modeloServeExecucao(request.resource.data, get(/databases/$(database)/documents/checklistModelos/$(request.resource.data.modeloId)).data)
          && totaisChecklistOk(request.resource.data, get(/databases/$(database)/documents/checklistModelos/$(request.resource.data.modeloId)).data)
        ) : false;

      // Só a observação do proprietário (franqueado da unidade) muda depois do envio.
      allow update: if request.resource.data.obsProprietarioPor == request.auth.uid ? (
          signedIn() && exists(userPath())
          && userData().papel == 'franqueado'
          && unidadeChecklist(userData())
          && resource.data.unidadeId == userData().unidadeId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['obsProprietario', 'obsProprietarioPor', 'obsProprietarioNome', 'obsProprietarioEm'])
          && request.resource.data.obsProprietario is string
          && request.resource.data.obsProprietario.size() >= 2
          && request.resource.data.obsProprietario.size() <= 2000
          && request.resource.data.obsProprietarioNome == userData().nome
          && request.resource.data.obsProprietarioEm == request.time
        ) : false;
      allow delete: if false;
    }

    // ===== Módulo 8: Auditoria e Qualidade =====
    function gereAuditoria(dados) {
      return contaAtiva(dados)
        && (
          dados.papel == 'admin'
          || (dados.papel == 'equipe_franqueadora' && temLista(dados, 'auditoria'))
        );
    }

    // Pessoa da unidade auditada (não depende de módulo: a auditoria é da franqueadora).
    function daUnidadeAuditada(dados, unidadeId) {
      return contaAtiva(dados)
        && dados.papel in ['franqueado', 'equipe_franqueado']
        && unidadeAtiva(dados)
        && unidadeIdPreenchido(dados)
        && dados.unidadeId == unidadeId;
    }

    function auditoriaPath(id) {
      return /databases/$(database)/documents/auditorias/$(id);
    }

    function isValidModeloAuditoria(data) {
      return data.keys().hasOnly(['titulo', 'descricao', 'itens', 'totalItens', 'pesoTotal', 'notaMinima', 'versao', 'ativo', 'geradoPorIA', 'iaModelo', 'criadoEm', 'atualizadoPor', 'atualizadoPorNome', 'atualizadoEm'])
        && data.keys().hasAll(['titulo', 'descricao', 'itens', 'totalItens', 'pesoTotal', 'notaMinima', 'versao', 'ativo', 'geradoPorIA', 'iaModelo', 'criadoEm', 'atualizadoPor', 'atualizadoPorNome', 'atualizadoEm'])
        && validName(data.titulo)
        && validShort(data.descricao, 1000)
        && data.itens is list && data.itens.size() >= 1 && data.itens.size() <= 80
        && data.totalItens == data.itens.size()
        && data.pesoTotal is int && data.pesoTotal >= data.totalItens && data.pesoTotal <= data.totalItens * 10
        && data.notaMinima is int && data.notaMinima >= 0 && data.notaMinima <= 100
        && data.versao is int && data.versao >= 1
        && data.ativo is bool
        && iaOk(data)
        && data.criadoEm is timestamp
        && data.atualizadoPor == request.auth.uid
        && data.atualizadoEm == request.time;
    }

    function isValidAuditoria(data) {
      return data.keys().hasOnly(['unidadeId', 'unidadeNome', 'modeloId', 'modeloTitulo', 'modeloVersao', 'modalidade', 'dataVisita', 'auditorUid', 'auditorNome', 'respostas', 'totalItens', 'pesoTotal', 'qtdOk', 'qtdNaoOk', 'qtdNa', 'pontosObtidos', 'pontosPossiveis', 'score', 'notaMinima', 'checklistExecucaoId', 'checklistScore', 'resultado', 'obsGeral', 'geradoPorIA', 'iaModelo', 'status', 'assinaturaAuditorUid', 'assinaturaAuditorNome', 'assinaturaAuditorEm', 'cienciaUid', 'cienciaNome', 'cienciaEm', 'contestacao', 'criadoEm', 'atualizadoEm'])
        && data.keys().hasAll(['unidadeId', 'unidadeNome', 'modeloId', 'modeloTitulo', 'modeloVersao', 'modalidade', 'dataVisita', 'auditorUid', 'auditorNome', 'respostas', 'totalItens', 'pesoTotal', 'qtdOk', 'qtdNaoOk', 'qtdNa', 'pontosObtidos', 'pontosPossiveis', 'score', 'notaMinima', 'checklistExecucaoId', 'checklistScore', 'resultado', 'obsGeral', 'geradoPorIA', 'iaModelo', 'status', 'assinaturaAuditorUid', 'assinaturaAuditorNome', 'assinaturaAuditorEm', 'cienciaUid', 'cienciaNome', 'cienciaEm', 'contestacao', 'criadoEm', 'atualizadoEm'])
        && data.unidadeId is string && data.unidadeId.size() > 0 && data.unidadeId.size() <= 64
        && validName(data.unidadeNome)
        && data.modeloId is string && data.modeloId.size() > 0 && data.modeloId.size() <= 64
        && validName(data.modeloTitulo)
        && data.modeloVersao is int
        && data.modalidade in ['visita', 'presencial', 'remota']
        && data.dataVisita is timestamp
        && data.respostas is list && data.respostas.size() == data.totalItens
        && data.totalItens is int && data.totalItens >= 1 && data.totalItens <= 80
        && data.pesoTotal is int
        && totaisChecklistOk(data, data)
        && data.notaMinima is int && data.notaMinima >= 0 && data.notaMinima <= 100
        && data.checklistExecucaoId is string && data.checklistExecucaoId.size() <= 64
        && (data.checklistExecucaoId == ''
          ? data.checklistScore == null
          : (data.checklistScore is int && data.checklistScore >= 0 && data.checklistScore <= 100))
        // Aprovação pela pontuação: a auditoria e, se houver, o checklist de referência atingem a nota mínima.
        && data.resultado == ((data.score >= data.notaMinima && (data.checklistScore == null || data.checklistScore >= data.notaMinima)) ? 'aprovada' : 'reprovada')
        && validShort(data.obsGeral, 4000)
        && iaOk(data)
        && data.status in ['rascunho', 'aguardando_ciencia', 'concluida']
        && validShort(data.contestacao, 2000)
        && data.criadoEm is timestamp
        && data.atualizadoEm == request.time;
    }

    function checklistDaAuditoriaOk(data) {
      return data.checklistExecucaoId == ''
        || (
          exists(/databases/$(database)/documents/checklistExecucoes/$(data.checklistExecucaoId))
          && get(/databases/$(database)/documents/checklistExecucoes/$(data.checklistExecucaoId)).data.unidadeId == data.unidadeId
        );
    }

    function assinaturaVazia(data) {
      return data.assinaturaAuditorUid == '' && data.assinaturaAuditorNome == '' && data.assinaturaAuditorEm == null;
    }

    function cienciaVazia(data) {
      return data.cienciaUid == '' && data.cienciaNome == '' && data.cienciaEm == null && data.contestacao == '';
    }

    function modeloServeAuditoria(data, modelo) {
      return modelo.ativo == true
        && data.modeloVersao == modelo.versao
        && data.modeloTitulo == modelo.titulo
        && data.totalItens == modelo.totalItens
        && data.pesoTotal == modelo.pesoTotal;
    }

    function isValidAcao(data) {
      return data.keys().hasOnly(['auditoriaId', 'unidadeId', 'itemId', 'itemTexto', 'descricao', 'responsavel', 'prazo', 'status', 'evidenciaUrl', 'comentarioUnidade', 'comentarioFranqueadora', 'criadoEm', 'atualizadoPor', 'atualizadoPorNome', 'atualizadoEm'])
        && data.keys().hasAll(['auditoriaId', 'unidadeId', 'itemId', 'itemTexto', 'descricao', 'responsavel', 'prazo', 'status', 'evidenciaUrl', 'comentarioUnidade', 'comentarioFranqueadora', 'criadoEm', 'atualizadoPor', 'atualizadoPorNome', 'atualizadoEm'])
        && validShort(data.itemId, 64)
        && validShort(data.itemTexto, 300)
        && data.descricao is string && data.descricao.size() >= 2 && data.descricao.size() <= 1000
        && validName(data.responsavel)
        && data.prazo is timestamp
        && data.status in ['aberta', 'em_andamento', 'concluida_unidade', 'validada', 'reaberta']
        && linkHttps(data.evidenciaUrl, true)
        && validShort(data.comentarioUnidade, 1000)
        && validShort(data.comentarioFranqueadora, 1000)
        && data.criadoEm is timestamp
        && data.atualizadoPor == request.auth.uid
        && data.atualizadoEm == request.time;
    }

    match /auditoriaModelos/{modeloId} {
      allow read: if signedIn() && exists(userPath()) && gereAuditoria(userData());
      allow create: if request.resource.data.atualizadoPor == request.auth.uid ? (
          signedIn() && exists(userPath())
          && gereAuditoria(userData())
          && isValidModeloAuditoria(request.resource.data)
          && request.resource.data.atualizadoPorNome == userData().nome
          && request.resource.data.versao == 1
          && request.resource.data.criadoEm == request.time
        ) : false;
      allow update: if request.resource.data.atualizadoPor == request.auth.uid ? (
          signedIn() && exists(userPath())
          && gereAuditoria(userData())
          && isValidModeloAuditoria(request.resource.data)
          && request.resource.data.atualizadoPorNome == userData().nome
          && request.resource.data.criadoEm == resource.data.criadoEm
          && request.resource.data.versao == (
            request.resource.data.itens == resource.data.itens
              && request.resource.data.titulo == resource.data.titulo
              && request.resource.data.pesoTotal == resource.data.pesoTotal
              ? resource.data.versao : resource.data.versao + 1)
        ) : false;
      allow delete: if false;
    }

    match /auditorias/{auditoriaId} {
      allow read: if signedIn() && exists(userPath()) && gereAuditoria(userData());
      // Unidade (franqueado e equipe, só leitura): auditorias assinadas pelo auditor, da própria unidade.
      allow read: if resource.data.status in ['aguardando_ciencia', 'concluida'] ? (
          signedIn() && exists(userPath())
          && daUnidadeAuditada(userData(), resource.data.unidadeId)
        ) : false;

      allow create: if request.resource.data.auditorUid == request.auth.uid && request.resource.data.status == 'rascunho' ? (
          signedIn() && exists(userPath())
          && gereAuditoria(userData())
          && isValidAuditoria(request.resource.data)
          && request.resource.data.auditorNome == userData().nome
          && request.resource.data.criadoEm == request.time
          && assinaturaVazia(request.resource.data)
          && cienciaVazia(request.resource.data)
          && exists(unidadePath(request.resource.data.unidadeId))
          && exists(/databases/$(database)/documents/auditoriaModelos/$(request.resource.data.modeloId))
          && modeloServeAuditoria(request.resource.data, get(/databases/$(database)/documents/auditoriaModelos/$(request.resource.data.modeloId)).data)
          && checklistDaAuditoriaOk(request.resource.data)
        ) : false;

      // Auditor: edita o rascunho e assina (a assinatura congela o conteúdo).
      allow update: if resource.data.status == 'rascunho' ? (
          signedIn() && exists(userPath())
          && gereAuditoria(userData())
          && (resource.data.auditorUid == request.auth.uid || userData().papel == 'admin')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['modalidade', 'dataVisita', 'respostas', 'qtdOk', 'qtdNaoOk', 'qtdNa', 'pontosObtidos', 'pontosPossiveis', 'score', 'notaMinima', 'checklistExecucaoId', 'checklistScore', 'resultado', 'obsGeral', 'geradoPorIA', 'iaModelo', 'status', 'assinaturaAuditorUid', 'assinaturaAuditorNome', 'assinaturaAuditorEm', 'atualizadoEm'])
          && isValidAuditoria(request.resource.data)
          && checklistDaAuditoriaOk(request.resource.data)
          && (request.resource.data.status == 'rascunho'
            ? assinaturaVazia(request.resource.data)
            : (request.resource.data.status == 'aguardando_ciencia'
              && request.resource.data.assinaturaAuditorUid == request.auth.uid
              && request.resource.data.assinaturaAuditorNome == userData().nome
              && request.resource.data.assinaturaAuditorEm == request.time))
        ) : false;

      // Franqueado da unidade: assina a ciência (com contestação opcional). Depois disso, nada muda.
      allow update: if resource.data.status == 'aguardando_ciencia' && request.resource.data.cienciaUid == request.auth.uid ? (
          signedIn() && exists(userPath())
          && userData().papel == 'franqueado'
          && daUnidadeAuditada(userData(), resource.data.unidadeId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cienciaUid', 'cienciaNome', 'cienciaEm', 'contestacao', 'atualizadoEm'])
          && request.resource.data.status == 'concluida'
          && request.resource.data.cienciaNome == userData().nome
          && request.resource.data.cienciaEm == request.time
          && request.resource.data.atualizadoEm == request.time
          && validShort(request.resource.data.contestacao, 2000)
        ) : false;
      allow delete: if false;
    }

    match /auditoriaAcoes/{acaoId} {
      allow read: if signedIn() && exists(userPath()) && gereAuditoria(userData());
      allow read: if signedIn() && exists(userPath()) && daUnidadeAuditada(userData(), resource.data.unidadeId);

      // Franqueadora: cria o plano para uma auditoria já assinada pelo auditor.
      allow create: if request.resource.data.atualizadoPor == request.auth.uid && request.resource.data.status == 'aberta' ? (
          signedIn() && exists(userPath())
          && gereAuditoria(userData())
          && isValidAcao(request.resource.data)
          && request.resource.data.atualizadoPorNome == userData().nome
          && request.resource.data.criadoEm == request.time
          && request.resource.data.evidenciaUrl == ''
          && request.resource.data.comentarioUnidade == ''
          && exists(auditoriaPath(request.resource.data.auditoriaId))
          && get(auditoriaPath(request.resource.data.auditoriaId)).data.status in ['aguardando_ciencia', 'concluida']
          && get(auditoriaPath(request.resource.data.auditoriaId)).data.unidadeId == request.resource.data.unidadeId
        ) : false;

      // Franqueadora: ajusta o plano e valida ou reabre o que a unidade concluiu.
      allow update: if resource.data.status != 'validada' && request.resource.data.atualizadoPor == request.auth.uid ? (
          signedIn() && exists(userPath())
          && gereAuditoria(userData())
          && isValidAcao(request.resource.data)
          && request.resource.data.atualizadoPorNome == userData().nome
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'descricao', 'responsavel', 'prazo', 'comentarioFranqueadora', 'atualizadoPor', 'atualizadoPorNome', 'atualizadoEm'])
          && (request.resource.data.status == resource.data.status
            || (resource.data.status == 'concluida_unidade' && request.resource.data.status in ['validada', 'reaberta']))
        ) : false;

      // Franqueado da unidade: andamento e conclusão com evidência (a equipe só lê).
      allow update: if resource.data.status in ['aberta', 'em_andamento', 'reaberta']
          && request.resource.data.status in ['em_andamento', 'concluida_unidade']
          && request.resource.data.atualizadoPor == request.auth.uid ? (
          signedIn() && exists(userPath())
          && userData().papel == 'franqueado'
          && daUnidadeAuditada(userData(), resource.data.unidadeId)
          && isValidAcao(request.resource.data)
          && request.resource.data.atualizadoPorNome == userData().nome
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'evidenciaUrl', 'comentarioUnidade', 'atualizadoPor', 'atualizadoPorNome', 'atualizadoEm'])
          && (request.resource.data.status == 'em_andamento' || linkHttps(request.resource.data.evidenciaUrl, false))
        ) : false;
      allow delete: if false;
    }
  }
}
