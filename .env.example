# Opcional. O projeto ubox-portal-franqueado já está em src/firebaseConfig.ts.
# Estas variáveis só substituem o fallback quando não estão vazias.
# No GitHub Actions, crie como Variables (não Secrets): elas entram no JavaScript público.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# IA ligada por padrão. Use false para desligar o Gemini.
VITE_AI_ENABLED=
# Opcional. Padrão: gemini-3.8-flash
VITE_AI_MODEL=

# Deixe vazio. O Cloud Storage não está disponível no plano Spark.
VITE_STORAGE_ENABLED=

# Opcional. Site key do reCAPTCHA v3, se o App Check estiver exigido para a IA.
VITE_APPCHECK_SITE_KEY=

# true só com os emuladores locais. Não defina no GitHub Actions.
VITE_USE_EMULATOR=false

# Scripts npm run make-admin e npm run seed.
ADMIN_EMAIL=
ADMIN_PASSWORD=
