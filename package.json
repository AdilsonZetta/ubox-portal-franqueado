{
  "name": "ubox-portal-franqueado",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/check-rules.mjs && vitest run && npm run test:rules",
    "test:rules": "npx -y firebase-tools@latest emulators:exec --only firestore --project demo-ubox \"node tests/regras.mjs\"",
    "deploy:rules": "npx -y firebase-tools@latest deploy --only firestore:rules,firestore:indexes --project ubox-portal-franqueado",
    "make-admin": "node scripts/make-admin.mjs",
    "migrar-modulos": "node --experimental-strip-types scripts/migrar-modulos.mjs",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-link": "^3.34.0",
    "@tiptap/extension-placeholder": "^3.34.0",
    "@tiptap/extension-table": "^3.34.0",
    "@tiptap/extension-table-cell": "^3.34.0",
    "@tiptap/extension-table-header": "^3.34.0",
    "@tiptap/extension-table-row": "^3.34.0",
    "@tiptap/extension-task-item": "^3.34.0",
    "@tiptap/extension-task-list": "^3.34.0",
    "@tiptap/extension-underline": "^3.34.0",
    "@tiptap/extension-youtube": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "dompurify": "^3.4.18",
    "firebase": "^13.3.0",
    "lucide-react": "^1.73.0",
    "mammoth": "^1.13.0",
    "marked": "^18.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
